<%- include('partials/header', { pageTitle: 'Лента - twix by salonamasle', activeNav }) %>

<form
  class="filters"
  method="GET"
  action="<%= activeNav === 'videos' ? '/videos' : '/' %>"
>
  <!-- Категория (только для общей ленты — во вкладке "Видео" всегда только YouTube-ролики) -->
  <% if (activeNav !== 'videos') { %>
  <div class="filter-dropdown" data-filter="category">
    <button type="button" class="filter-dropdown-toggle">
      <span class="filter-dropdown-value">
        <%= category === 'image' ? 'Изображения' :
            category === 'video' ? 'Видео' :
            category === 'audio' ? 'Аудио' :
            category === 'album' ? 'Альбомы' :
            'Всё' %>
      </span>

      <span class="filter-dropdown-arrow"></span>
    </button>

    <div class="filter-dropdown-menu">
      <button
        type="button"
        class="filter-dropdown-option <%= category === 'all' ? 'selected' : '' %>"
        data-value="all"
      >
        Всё
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= category === 'image' ? 'selected' : '' %>"
        data-value="image"
      >
        Изображения
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= category === 'video' ? 'selected' : '' %>"
        data-value="video"
      >
        Видео
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= category === 'audio' ? 'selected' : '' %>"
        data-value="audio"
      >
        Аудио
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= category === 'album' ? 'selected' : '' %>"
        data-value="album"
      >
        Альбомы
      </button>
    </div>

    <input
      type="hidden"
      name="category"
      value="<%= category || 'all' %>"
    >
  </div>
  <% } %>


  <!-- Сортировка -->
  <div class="filter-dropdown" data-filter="sort">
    <button type="button" class="filter-dropdown-toggle">
      <span class="filter-dropdown-value">
        <%= sort === 'views' ? 'По просмотрам' :
            sort === 'likes' ? 'По лайкам' :
            sort === 'comments' ? 'По комментариям' :
            'Новое' %>
      </span>

      <span class="filter-dropdown-arrow"></span>
    </button>

    <div class="filter-dropdown-menu">
      <button
        type="button"
        class="filter-dropdown-option <%= sort === 'new' ? 'selected' : '' %>"
        data-value="new"
      >
        Новое
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= sort === 'views' ? 'selected' : '' %>"
        data-value="views"
      >
        По просмотрам
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= sort === 'likes' ? 'selected' : '' %>"
        data-value="likes"
      >
        По лайкам
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= sort === 'comments' ? 'selected' : '' %>"
        data-value="comments"
      >
        По комментариям
      </button>
    </div>

    <input
      type="hidden"
      name="sort"
      value="<%= sort || 'new' %>"
    >
  </div>


  <!-- Период -->
  <div class="filter-dropdown" data-filter="period">
    <button type="button" class="filter-dropdown-toggle">
      <span class="filter-dropdown-value">
        <%= period === 'today' ? 'Сегодня' :
            period === 'week' ? 'Неделя' :
            period === 'month' ? 'Месяц' :
            period === 'year' ? 'Год' :
            'Всё время' %>
      </span>

      <span class="filter-dropdown-arrow"></span>
    </button>

    <div class="filter-dropdown-menu">
      <button
        type="button"
        class="filter-dropdown-option <%= period === 'today' ? 'selected' : '' %>"
        data-value="today"
      >
        Сегодня
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= period === 'week' ? 'selected' : '' %>"
        data-value="week"
      >
        Неделя
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= period === 'month' ? 'selected' : '' %>"
        data-value="month"
      >
        Месяц
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= period === 'year' ? 'selected' : '' %>"
        data-value="year"
      >
        Год
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= period === 'all' ? 'selected' : '' %>"
        data-value="all"
      >
        Всё время
      </button>
    </div>

    <input
      type="hidden"
      name="period"
      value="<%= period || 'all' %>"
    >
  </div>


  <!-- Кнопка предложения видео -->
  <button
    type="button"
    id="open-suggest-video"
    class="btn-suggest-video desktop-suggest-btn"
  >
    Предложить видео
  </button>
</form>

<div
  class="grid"
  id="posts-grid"
  data-endpoint="<%= activeNav === 'videos' ? '/api/videos' : '/api/feed' %>"
  data-page="<%= page || 1 %>"
  data-has-more="<%= hasMore ? '1' : '0' %>"
>
  <% if (posts.length === 0) { %>
    <p class="empty" id="empty-feed">Нет файлов для отображения</p>
  <% } %>

  <%- include('partials/post-cards', { posts }) %>
</div>

<!-- Бесконечная подгрузка -->
<div id="feed-sentinel" aria-hidden="true"></div>
<p id="feed-loading" class="feed-status" hidden>Загрузка…</p>
<p id="feed-end" class="feed-status" <%= (posts.length === 0 || hasMore) ? 'hidden' : '' %>>Это все публикации</p>

<!-- Мобильная кнопка -->
<div class="mobile-suggest-container">
<button type="button" class="btn-suggest-video" onclick="document.getElementById('open-suggest-video').click()">
    Предложить видео
  </button>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const openBtn = document.getElementById('open-suggest-video');

    if (openBtn) {
      openBtn.addEventListener('click', () => {
        // Открываем popup, который подключается через footer.ejs
        const modal = document.getElementById('suggest-video-modal');

        if (modal) {
          modal.hidden = false;
          modal.style.display = 'flex';
        }
      });
    }
  });
</script>

<!-- Мобильная кнопка -->
<div class="mobile-suggest-container">
  <button type="button" class="btn-suggest-video" onclick="document.getElementById('open-suggest-video').click()">
    Предложить видео
  </button>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var dropdowns = document.querySelectorAll('.filter-dropdown');

    dropdowns.forEach(function (dropdown) {
      var toggle = dropdown.querySelector('.filter-dropdown-toggle');
      var options = dropdown.querySelectorAll('.filter-dropdown-option');
      var input = dropdown.querySelector('input[type="hidden"]');
      var valueEl = dropdown.querySelector('.filter-dropdown-value');

      toggle.addEventListener('click', function (e) {
        e.stopPropagation();

        dropdowns.forEach(function (other) {
          if (other !== dropdown) {
            other.classList.remove('open');
          }
        });

        dropdown.classList.toggle('open');
      });

      options.forEach(function (option) {
        option.addEventListener('click', function (e) {
          e.stopPropagation();

          var value = option.dataset.value;
          var text = option.textContent.trim();

          input.value = value;
          valueEl.textContent = text;

          options.forEach(function (item) {
            item.classList.remove('selected');
          });

          option.classList.add('selected');
          dropdown.classList.remove('open');

          dropdown.closest('form').submit();
        });
      });
    });

    document.addEventListener('click', function () {
      dropdowns.forEach(function (dropdown) {
        dropdown.classList.remove('open');
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        dropdowns.forEach(function (dropdown) {
          dropdown.classList.remove('open');
        });
      }
    });
  });
</script>

<%- include('partials/footer') %>

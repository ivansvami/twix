<%- include('partials/header', { pageTitle: 'Редактирование поста - twix by salonamasle' }) %>

<div class="edit-post-page">
  <div class="edit-post-card">
    <h1 class="edit-post-heading">Редактирование поста</h1>
    <% if (error) { %><p class="error edit-post-error"><%= error %></p><% } %>

    <form action="/post/<%= post.shortId %>/edit" method="POST" class="edit-post-form">
      <label class="edit-post-field">
        <span class="edit-post-field-label">Заголовок поста</span>
        <input type="text" name="title" maxlength="200" value="<%= post.title %>" placeholder="Название поста">
      </label>

      <label class="edit-post-field edit-post-field-grow">
        <span class="edit-post-field-label">Описание</span>
        <textarea name="description" maxlength="2000" placeholder="Описание текст поста"><%= post.description %></textarea>
      </label>

      <div class="edit-post-actions edit-post-actions-stacked">
        <a href="/post/<%= post.shortId %>" class="btn-edit-cancel">Отмена</a>
        <button type="submit" class="btn-edit-save">Сохранить</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>

<%

  const firstFile = post.files && post.files[0] ? post.files[0] : null;

  const firstUrl = firstFile ? firstFile.url : '';

  

  // Проверяем точное наличие ссылок на TikTok, Instagram Reels или YouTube Shorts

  const isTiktok = firstUrl && firstUrl.includes('tiktok.com');

  const isInsta = firstUrl && (firstUrl.includes('instagram.com/reel') || firstUrl.includes('/reels/'));

  const isYtShorts = firstUrl && firstUrl.includes('shorts/');



  const isVerticalVideo = isTiktok || isInsta || isYtShorts;

%>



<div class="post-modal-inner" data-post-shortid="<%= post.shortId %>">

  <a href="/" class="post-close js-close-post" aria-label="Закрыть">✕</a>



<div class="post-media-area" style="position: relative; width: 100%; height: 100%; min-height: 500px; background: #000; overflow: hidden; display: block;">

  <div class="pm-carousel" data-pm-carousel>

    <div class="pm-track" data-pm-track>

    <% post.files.forEach(function(f) {

      const ytMatch = f.url && f.url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([\w-]{11})/);

      const tiktokMatch = f.url && f.url.match(/tiktok\.com\/.*\/video\/(\d+)/);

      const instaMatch = f.url && f.url.match(/instagram\.com\/(?:reel|reels)\/([\w-]+)/);



      const ytEmbedUrl = ytMatch ? 'https://www.youtube.com/embed/' + ytMatch[1] : null;

      const tiktokEmbedUrl = tiktokMatch ? 'https://www.tiktok.com/embed/v2/' + tiktokMatch[1] : null;

      const instaEmbedUrl = instaMatch ? 'https://www.instagram.com/reel/' + instaMatch[1] + '/embed/' : null;

    %>

      <div class="pm-slide" data-pm-slide>

      <% if (ytEmbedUrl) { %>

        <iframe src="<%= ytEmbedUrl %>" title="YouTube" loading="lazy" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position:absolute; top:0; left:0; width:100%; height:100%; border:0;<% if (post.files.length > 1) { %>pointer-events:none;<% } %>"></iframe>

      <% } else if (tiktokEmbedUrl) { %>

        <!-- Абсолютное позиционирование растягивает iframe на весь блок -->

        <iframe src="<%= tiktokEmbedUrl %>" title="TikTok" loading="lazy" allow="autoplay; encrypted-media" allowfullscreen style="position:absolute; top:0; left:0; width:100%; height:100%; border:0;<% if (post.files.length > 1) { %>pointer-events:none;<% } %>"></iframe>

      <% } else if (instaEmbedUrl) { %>

        <iframe src="<%= instaEmbedUrl %>" title="Instagram" loading="lazy" allow="autoplay; encrypted-media" allowfullscreen style="position:absolute; top:0; left:0; width:100%; height:100%; border:0;<% if (post.files.length > 1) { %>pointer-events:none;<% } %>"></iframe>

<% } else if (f.resourceType === 'video') { %>

        <div class="custom-player" data-custom-player>
          <video src="<%= f.url %>" playsinline class="cp-video"></video>

          <button type="button" class="cp-bigplay" aria-label="Воспроизвести">
            <svg width="34" height="34" viewBox="0 0 34 34" fill="none"><g opacity="0.9"><path d="M14.014 8.77297C12.6808 7.98869 11 8.95 11 10.4968V23.5032C11 25.05 12.6808 26.0113 14.014 25.227L25.0694 18.7239C26.384 17.9506 26.384 16.0494 25.0694 15.2761L14.014 8.77297Z" fill="#fff"/></g></svg>
          </button>

          <div class="cp-controls">
            <div class="cp-progress" role="slider" aria-label="Перемотка" tabindex="0">
              <div class="cp-progress-track"></div>
              <div class="cp-progress-buffered"></div>
              <div class="cp-progress-fill"></div>
              <div class="cp-progress-handle"></div>
            </div>

            <div class="cp-bar">
              <button type="button" class="cp-btn cp-play" aria-label="Пауза/Воспроизвести">
                <span class="cp-icon cp-icon-play">
                  <svg width="30" height="30" viewBox="0 0 34 34" fill="none"><g opacity="0.9"><path d="M11 10.4976C11 8.95092 12.6805 7.98917 14.0137 8.77298L25.0693 15.2769C26.3839 16.0502 26.3839 17.9509 25.0693 18.7241L14.0137 25.2271C12.6804 26.0112 11 25.0502 11 23.5034V10.4976Z" fill="#fff"/></g></svg>
                </span>
                <span class="cp-icon cp-icon-pause">
                  <svg width="30" height="30" viewBox="0 0 34 34" fill="none"><g opacity="0.9"><path d="M13 8C14.1046 8 15 8.89543 15 10V24C15 25.1046 14.1046 26 13 26C11.8954 26 11 25.1046 11 24V10C11 8.89543 11.8954 8 13 8Z" fill="#fff"/><path d="M21 8C22.1046 8 23 8.89543 23 10V24C23 25.1046 22.1046 26 21 26C19.8954 26 19 25.1046 19 24V10C19 8.89543 19.8954 8 21 8Z" fill="#fff"/></g></svg>
                </span>
              </button>

              <span class="cp-time">0:00 / 0:00</span>

              <div class="cp-volume-wrap">
                <button type="button" class="cp-btn cp-mute" aria-label="Звук">
                  <span class="cp-icon cp-icon-vol-on">
                    <svg width="30" height="30" viewBox="0 0 34 34" fill="none"><path d="M17.8779 8.37109C18.5683 7.92586 19.4943 8.02882 20.0312 8.69043L20.1406 8.8418L20.209 8.96191C20.3499 9.24195 20.3633 9.5159 20.3633 9.66699V24.333C20.3633 24.5065 20.346 24.8392 20.1406 25.1582C19.5943 26.0062 18.4814 26.1227 17.7344 25.5244L12.4287 21.2764H8.84668C7.8407 21.2764 7.10156 20.4313 7.10156 19.4873V14.5127C7.1016 13.5687 7.84072 12.7236 8.84668 12.7236H12.4287L17.7344 8.47559L17.8779 8.37109ZM13.5342 14.1455C13.2309 14.3883 12.8535 14.5244 12.46 14.5244H8.90234V19.4756H12.46C12.8042 19.4756 13.1363 19.5798 13.417 19.7686L13.5342 19.8545L18.5635 23.8828V10.1162L13.5342 14.1455ZM24.3154 11.1875C24.7028 10.9284 25.2191 11.0097 25.5098 11.3613L25.5645 11.4355L25.5654 11.4365L25.5664 11.4385L25.5684 11.4414C25.57 11.444 25.572 11.4477 25.5742 11.4512C25.5786 11.458 25.5844 11.4664 25.5908 11.4766C25.604 11.4975 25.6219 11.5256 25.6426 11.5605C25.6839 11.6305 25.7386 11.7289 25.8027 11.8545C25.9313 12.1061 26.0969 12.469 26.2598 12.9385C26.5858 13.8785 26.9023 15.2444 26.9023 17C26.9023 18.7555 26.5858 20.1215 26.2598 21.0615C26.097 21.5308 25.9312 21.8929 25.8027 22.1445C25.7386 22.27 25.6839 22.3685 25.6426 22.4385C25.622 22.4734 25.604 22.5016 25.5908 22.5225C25.5843 22.5329 25.5787 22.5419 25.5742 22.5488C25.572 22.5522 25.57 22.5551 25.5684 22.5576L25.5664 22.5615L25.5645 22.5635C25.2881 22.9766 24.7285 23.0879 24.3154 22.8115C23.9031 22.5353 23.792 21.9773 24.0674 21.5645L24.0684 21.5635C24.0726 21.5568 24.0811 21.5432 24.0928 21.5234C24.1163 21.4836 24.1535 21.4176 24.2002 21.3262C24.2939 21.1427 24.4251 20.8565 24.5586 20.4717C24.8253 19.7026 25.1015 18.5358 25.1016 17C25.1016 15.4641 24.8254 14.2974 24.5586 13.5283C24.4251 13.1435 24.2939 12.8573 24.2002 12.6738C24.1536 12.5825 24.1163 12.5164 24.0928 12.4766C24.0812 12.457 24.0726 12.4433 24.0684 12.4365L24.0664 12.4336C23.7924 12.0208 23.9033 11.4633 24.3154 11.1875ZM21.8389 12.876C22.252 12.5997 22.8105 12.711 23.0869 13.124L23.0879 13.125L23.0889 13.127L23.0908 13.1299C23.0923 13.1321 23.0948 13.1348 23.0967 13.1377C23.1003 13.1433 23.1044 13.1503 23.1094 13.1582C23.1196 13.1745 23.1332 13.1958 23.1484 13.2217C23.179 13.2734 23.219 13.3442 23.2646 13.4336C23.3561 13.6127 23.4715 13.8673 23.585 14.1943C23.8122 14.8495 24.0293 15.7931 24.0293 17C24.0293 18.2068 23.8122 19.1505 23.585 19.8057C23.4716 20.1325 23.3561 20.3873 23.2646 20.5664C23.2189 20.6559 23.179 20.7276 23.1484 20.7793C23.1333 20.805 23.1196 20.8256 23.1094 20.8418C23.1043 20.8499 23.1004 20.8575 23.0967 20.8633C23.0948 20.8661 23.0923 20.8688 23.0908 20.8711L23.0889 20.874L23.0879 20.875C23.0881 20.8748 23.0907 20.8713 23.0869 20.877C22.8104 21.2897 22.2519 21.4003 21.8389 21.124C21.426 20.8477 21.3148 20.289 21.5908 19.876C21.5928 19.8728 21.5956 19.8684 21.5986 19.8633C21.6113 19.8418 21.633 19.8031 21.6611 19.748C21.7178 19.637 21.7996 19.4584 21.8838 19.2158C22.0517 18.7316 22.2295 17.9872 22.2295 17C22.2295 16.0128 22.0517 15.2684 21.8838 14.7842C21.7997 14.5419 21.7178 14.3639 21.6611 14.2529C21.6328 14.1975 21.6113 14.1582 21.5986 14.1367C21.5957 14.1318 21.5927 14.1281 21.5908 14.125L21.5439 14.0459C21.3297 13.643 21.4515 13.1351 21.8389 12.876Z" fill="#fff"/></svg>
                  </span>
                  <span class="cp-icon cp-icon-vol-off">
                    <svg width="30" height="30" viewBox="0 0 34 34" fill="none"><path d="M21.4629 17.0996C21.9599 17.0996 22.3632 17.503 22.3633 18V24.333C22.3633 24.5057 22.3461 24.8389 22.1406 25.1582C21.6047 25.9901 20.5245 26.1169 19.7783 25.5566V25.5576L16.4834 23.2354C16.0773 22.949 15.9803 22.3877 16.2666 21.9814C16.553 21.5754 17.1143 21.4784 17.5205 21.7646L20.5635 23.9092V18C20.5635 17.5031 20.966 17.0998 21.4629 17.0996ZM22.793 11.793C23.1835 11.4025 23.8165 11.4024 24.207 11.793C24.5975 12.1835 24.5975 12.8165 24.207 13.207L13.707 23.707C13.3165 24.0975 12.6835 24.0975 12.293 23.707C11.9024 23.3165 11.9024 22.6835 12.293 22.293L22.793 11.793ZM19.8779 8.37109C20.5683 7.92585 21.4943 8.02881 22.0312 8.69043L22.1406 8.8418L22.209 8.96191C22.3501 9.24232 22.3633 9.5172 22.3633 9.66797V11C22.3633 11.4971 21.9599 11.9004 21.4629 11.9004C20.966 11.9002 20.5635 11.4969 20.5635 11V10.1162L15.5342 14.1455C15.2309 14.3883 14.8535 14.5244 14.46 14.5244H10.9023V19.4756H12.002C12.499 19.4756 12.9023 19.879 12.9023 20.376C12.9023 20.873 12.499 21.2764 12.002 21.2764H10.8467C9.8407 21.2764 9.10156 20.4313 9.10156 19.4873V14.5127C9.10159 13.5687 9.84072 12.7236 10.8467 12.7236H14.4287L19.7344 8.47559L19.8779 8.37109Z" fill="#fff"/></svg>
                  </span>
                </button>
                <div class="cp-volume-popup">
                  <div class="cp-volume-slider" role="slider" aria-label="Громкость" aria-valuemin="0" aria-valuemax="100" tabindex="0">
                    <div class="cp-volume-track"></div>
                    <div class="cp-volume-fill"></div>
                    <div class="cp-volume-handle"></div>
                  </div>
                </div>
              </div>

              <div class="cp-speed-wrap">
                <button type="button" class="cp-btn cp-speed-toggle" aria-label="Настройки">
                  <svg width="30" height="30" viewBox="0 0 34 34" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M17.0005 13.0005C19.2095 13.0007 21.0005 14.7915 21.0005 17.0005C21.0003 19.2094 19.2094 21.0003 17.0005 21.0005C14.7915 21.0005 13.0007 19.2095 13.0005 17.0005C13.0005 14.7914 14.7914 13.0005 17.0005 13.0005ZM17.0005 14.8003C15.7855 14.8003 14.8003 15.7855 14.8003 17.0005C14.8005 18.2154 15.7856 19.2007 17.0005 19.2007C18.2153 19.2005 19.2005 18.2153 19.2007 17.0005C19.2007 15.7856 18.2154 14.8005 17.0005 14.8003Z" fill="#fff"/><path fill-rule="evenodd" clip-rule="evenodd" d="M15.5855 8.41358C16.3664 7.63288 17.6326 7.63307 18.4136 8.41358L19.3423 9.34229C19.6704 9.67037 20.1014 9.87291 20.5591 9.91846L20.7573 9.92823H22.0698C23.1741 9.9284 24.0695 10.824 24.0698 11.9282V13.2407L24.0796 13.439C24.1251 13.8966 24.3278 14.3277 24.6558 14.6558L25.5855 15.5855C26.3663 16.3665 26.3663 17.6326 25.5855 18.4136L24.6558 19.3433L24.522 19.4907C24.2307 19.8465 24.0699 20.2945 24.0698 20.7583V22.0708L24.0591 22.2749C23.9636 23.2163 23.2153 23.9645 22.2739 24.0601L22.0698 24.0708H20.7573L20.5591 24.0806C20.1014 24.1261 19.6704 24.3287 19.3423 24.6567L18.4136 25.5855L18.2622 25.7222C17.5289 26.3206 16.4702 26.3206 15.7368 25.7222L15.5855 25.5855L14.6567 24.6567C14.3286 24.3288 13.8976 24.126 13.4399 24.0806L13.2417 24.0708H11.9272L11.7231 24.0601C10.7819 23.9644 10.0335 23.2162 9.93799 22.2749L9.92725 22.0708V20.7554C9.92704 20.2252 9.7162 19.7162 9.34131 19.3413L8.41358 18.4136C7.68166 17.6812 7.63592 16.5222 8.27686 15.7368L8.41358 15.5855L9.34131 14.6577C9.66947 14.3295 9.87202 13.8987 9.91748 13.4409L9.92725 13.2437V11.9282C9.92756 10.8241 10.8231 9.92845 11.9272 9.92823H13.2417C13.7058 9.92823 14.1534 9.76669 14.5093 9.4751L14.6567 9.34229L15.5855 8.41358ZM17.1411 9.68604C17.063 9.60847 16.9359 9.60828 16.8579 9.68604L15.9292 10.6157C15.2166 11.3283 14.2495 11.728 13.2417 11.728H11.9272C11.8172 11.7283 11.7274 11.8182 11.7271 11.9282V13.2437C11.7269 14.2512 11.3271 15.2177 10.6147 15.9302L9.68604 16.8579C9.60824 16.9359 9.60846 17.063 9.68604 17.1411L10.6147 18.0689C11.3271 18.7813 11.7268 19.7479 11.7271 20.7554V22.0708C11.7272 22.181 11.8171 22.2708 11.9272 22.271H13.2417C14.2493 22.271 15.2166 22.6709 15.9292 23.3833L16.8579 24.313C16.936 24.3909 17.063 24.3909 17.1411 24.313L18.0698 23.3833C18.7824 22.6708 19.7497 22.2711 20.7573 22.271H22.0698C22.1801 22.2708 22.2689 22.1811 22.269 22.0708V20.7583C22.2691 19.7506 22.6698 18.7834 23.3823 18.0708L24.313 17.1411C24.3909 17.063 24.3909 16.936 24.313 16.8579L23.3823 15.9282C22.6699 15.2156 22.269 14.2484 22.269 13.2407V11.9282C22.2687 11.8181 22.1799 11.7282 22.0698 11.728H20.7573C19.7497 11.728 18.7824 11.3282 18.0698 10.6157L17.1411 9.68604Z" fill="#fff"/></svg>
                </button>
                <div class="cp-speed-menu" hidden>
                  <p class="cp-speed-title">Скорость</p>
                  <button type="button" class="cp-speed-option" data-speed="0.25">0.25</button>
                  <button type="button" class="cp-speed-option" data-speed="0.5">0.5</button>
                  <button type="button" class="cp-speed-option" data-speed="0.75">0.75</button>
                  <button type="button" class="cp-speed-option is-active" data-speed="1">Обычная</button>
                  <button type="button" class="cp-speed-option" data-speed="1.25">1.25</button>
                  <button type="button" class="cp-speed-option" data-speed="1.5">1.5</button>
                  <button type="button" class="cp-speed-option" data-speed="2">2</button>
                </div>
              </div>

              <button type="button" class="cp-btn cp-fullscreen" aria-label="Полный экран">
                <svg width="30" height="30" viewBox="0 0 34 34" fill="none"><path d="M23.002 10.0996C23.499 10.0996 23.9023 10.5029 23.9023 11V19.0996C23.9023 19.5967 23.499 20 23.002 20C22.5049 20 22.1016 19.5967 22.1016 19.0996V13.1738L13.1758 22.0996H19.1016C19.5986 22.0996 20.002 22.5029 20.002 23C20.002 23.4971 19.5986 23.9004 19.1016 23.9004H11.002C10.5049 23.9004 10.1016 23.4971 10.1016 23V14.9004C10.1016 14.4033 10.5049 14 11.002 14C11.499 14 11.9023 14.4033 11.9023 14.9004V20.8262L20.8281 11.9004H14.9023C14.4053 11.9004 14.002 11.4971 14.002 11C14.002 10.5029 14.4053 10.0996 14.9023 10.0996H23.002Z" fill="#fff"/></svg>
              </button>
            </div>
          </div>
        </div>

      <% } else if (f.resourceType === 'audio') { %>

        <div class="audio-wrap" style="display:flex; align-items:center; justify-content:center; height:100%;">

          <div class="audio-icon">🎵</div>

          <audio src="<%= f.url %>" controls></audio>

        </div>

      <% } else { %>

        <img src="<%= f.url %>" alt="" draggable="false" style="position:absolute; top:0; left:0; width:100%; height:100%; object-fit:contain;">

      <% } %>

      </div>

    <% }) %>

    </div>

    <% if (post.files.length > 1) { %>

      <button type="button" class="pm-arrow pm-arrow-prev" data-pm-prev aria-label="Предыдущий файл">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <button type="button" class="pm-arrow pm-arrow-next" data-pm-next aria-label="Следующий файл">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <div class="pm-dots" data-pm-dots role="tablist" aria-label="Вложения поста">
        <% post.files.forEach(function(f, i) { %>
          <button type="button" class="pm-dot <%= i === 0 ? 'is-active' : '' %>" data-pm-dot role="tab" aria-label="Показать вложение <%= i + 1 %> из <%= post.files.length %>"></button>
        <% }) %>
      </div>

    <% } %>

  </div>

  </div>



<div class="post-side post-side-new">

  <!-- Информация о посте -->
  <div class="post-info-new">

<div class="post-user-new">

  <div class="post-user-avatar-new">

    <% if (post.author && post.author.avatarUrl) { %>

      <img
        src="<%= post.author.avatarUrl %>"
        alt="<%= post.author.username %>"
      >

    <% } else { %>

      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
      >
        <circle
          cx="12"
          cy="8"
          r="3.5"
          stroke="white"
          stroke-width="2"
        />

        <path
          d="M5 21c.5-4 2.8-6 7-6s6.5 2 7 6"
          stroke="white"
          stroke-width="2"
          stroke-linecap="round"
        />
      </svg>

    <% } %>

  </div>

  <span>@<%= post.author.username %></span>

</div>


    <!-- Заголовок -->
    <h1 class="post-title-new">
      <%= post.title || 'Без названия' %>
    </h1>


    <!-- Описание -->
    <% if (post.description) { %>
      <div class="post-description-new"><%= post.description %></div>
    <% } %>


    <!-- Статистика -->
    <div class="post-actions-new">

      <div class="post-actions-left">

        <!-- Копировать ссылку -->
        <button
          type="button"
          id="copy-post-link"
          class="post-copy-link-new post-icon-btn"
          data-url="<%= '/post/' + post.shortId %>"
          aria-label="Скопировать ссылку"
        >
          <svg width="19" height="19" viewBox="0 0 30 30" fill="none">
            <path
              d="M16.1086 24.6494L14.279 26.479C11.5844 29.1737 7.21555 29.1737 4.52095 26.479C1.82635 23.7844 1.82635 19.4155 4.52095 16.7208L8.18021 13.0615C10.8748 10.3669 15.2436 10.3669 17.9382 13.0615M14.8914 6.35064L16.721 4.52098C19.4156 1.82634 23.7845 1.82634 26.479 4.52098C29.1736 7.21563 29.1737 11.5845 26.4791 14.2792L22.8198 17.9385C20.1252 20.6331 15.7564 20.6331 13.0618 17.9385"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
        </button>

        <!-- Лайк -->
        <button
          type="button"
          id="like-btn"
          data-shortid="<%= post.shortId %>"
          class="post-like-new post-icon-btn <%= currentUser && post.likes.some(id => id.toString() === currentUser._id.toString()) ? 'liked' : '' %>"
          aria-label="Поставить лайк"
        >
          <svg
            class="post-like-icon"
            width="19"
            height="19"
            viewBox="0 0 30 30"
            fill="none"
          >
            <path
              d="M8.12012 3C10.0049 3.00011 11.8142 3.75409 13.1494 5.09863L13.1504 5.09961C13.457 5.40732 13.8473 5.7863 14.3193 6.23438C14.7055 6.60093 15.3115 6.6004 15.6973 6.2334C16.168 5.78555 16.5571 5.40691 16.8633 5.09961L16.8643 5.10059C18.1939 3.76751 19.9904 3.01779 21.8633 3.0127C23.7362 3.00764 25.5373 3.74734 26.874 5.07324C28.2109 6.39929 28.975 8.20478 28.999 10.0977C29.023 11.9907 28.3041 13.8157 27.001 15.1758L15.4443 26.8164C15.3269 26.9345 15.1696 26.9999 15.0068 27C14.8439 27 14.6859 26.9347 14.5684 26.8164L3.00977 15.1758C1.70803 13.8233 0.985336 12.0078 1 10.1211C1.01468 8.23487 1.76683 6.43067 3.08984 5.09863C4.42514 3.75399 6.23516 3 8.12012 3Z"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"
            />
          </svg>

          <span id="like-count" class="post-like-count"><%= post.likes.length %></span>
        </button>

      </div>

      <div class="post-actions-center">

        <!-- Редактировать пост и удаление (только автор или админ) -->
        <% if (currentUser && post.author && (currentUser._id.toString() === post.author._id.toString() || currentUser.isAdmin)) { %>

          <a
            href="/post/<%= post.shortId %>/edit"
            class="post-edit-new post-icon-btn"
            aria-label="Редактировать публикацию"
          >
            <svg width="19" height="19" viewBox="0 0 30 30" fill="none">
              <path
                d="M14.6609 24.1258L25.0158 13.7719C23.6065 13.1854 21.9373 12.222 20.3587 10.6435C18.7798 9.06478 17.8162 7.39548 17.2297 5.98617L6.87467 16.3402C6.06664 17.1483 5.66255 17.5523 5.31509 17.9976C4.90518 18.5232 4.55378 19.0917 4.26704 19.6933C4.02397 20.2033 3.84329 20.7453 3.4819 21.8293L1.57623 27.5459C1.3984 28.0793 1.53724 28.6674 1.93491 29.0651C2.33257 29.4627 2.92078 29.6016 3.45429 29.4238L9.17131 27.5182C10.2554 27.1569 10.7975 26.9763 11.3076 26.7332C11.9092 26.4465 12.4778 26.0951 13.0034 25.6852C13.4487 25.3378 13.8529 24.9337 14.6609 24.1258Z"
                fill="currentColor"
              />
              <path
                d="M27.8874 10.898C30.0375 8.74806 30.0375 5.26235 27.8874 3.11244C25.7373 0.962519 22.2512 0.962519 20.1011 3.11244L18.8593 4.35426C18.8763 4.40561 18.8938 4.45766 18.9122 4.5104C19.3673 5.82236 20.2263 7.54222 21.842 9.15778C23.4577 10.7733 25.1777 11.6322 26.4899 12.0873C26.5424 12.1055 26.5942 12.1231 26.6453 12.14L27.8874 10.898Z"
                fill="currentColor"
              />
            </svg>
          </a>

          <!-- Удалить пост -->
          <form
            action="/post/<%= post.shortId %>/delete"
            method="POST"
            class="post-delete-form-new"
            onsubmit="return confirm('Удалить пост безвозвратно?');"
          >
            <button
              type="submit"
              class="post-delete-new post-icon-btn"
              aria-label="Удалить публикацию"
            >
              <svg width="19" height="19" viewBox="0 0 30 30" fill="none">
                <path
                  d="M26.557 6.6C26.9252 6.6004 27.2793 6.73703 27.5471 6.98199C27.8148 7.22694 27.9759 7.56173 27.9975 7.91795C28.0191 8.27417 27.8995 8.62493 27.6632 8.89857C27.4269 9.1722 27.0916 9.34805 26.726 9.3902L26.557 9.4H26.44L25.1124 24.8C25.1124 25.8713 24.6901 26.9021 23.9317 27.6816C23.1733 28.461 22.1363 28.9302 21.0327 28.993L20.7785 29H9.22151C6.913 29 5.02633 27.2514 4.8992 25.15L4.89198 24.9162L3.55859 9.4H3.44302C3.07482 9.3996 2.72066 9.26297 2.45292 9.01801C2.18518 8.77306 2.02406 8.43827 2.00248 8.08205C1.98091 7.72583 2.1005 7.37507 2.33682 7.10143C2.57315 6.8278 2.90837 6.65194 3.274 6.6098L3.44302 6.6H26.557ZM12.1108 12.2C11.7276 12.2 11.3602 12.3475 11.0893 12.6101C10.8183 12.8726 10.6661 13.2287 10.6661 13.6V22C10.6661 22.3713 10.8183 22.7274 11.0893 22.99C11.3602 23.2525 11.7276 23.4 12.1108 23.4C12.4939 23.4 12.8613 23.2525 13.1323 22.99C13.4032 22.7274 13.5554 22.3713 13.5554 22V13.6C13.5554 13.2287 13.4032 12.8726 13.1323 12.6101C12.8613 12.3475 12.4939 12.2 12.1108 12.2ZM17.8892 12.2C17.5061 12.2 17.1387 12.3475 16.8677 12.6101C16.5968 12.8726 16.4446 13.2287 16.4446 13.6V22C16.4446 22.3713 16.5968 22.7274 16.8677 22.99C17.1387 23.2525 17.5061 23.4 17.8892 23.4C18.2724 23.4 18.6398 23.2525 18.9107 22.99C19.1817 22.7274 19.3339 22.3713 19.3339 22V13.6C19.3339 13.2287 19.1817 12.8726 18.9107 12.6101C18.6398 12.3475 18.2724 12.2 17.8892 12.2ZM17.8892 1C18.6555 1 19.3904 1.295 19.9322 1.8201C20.4741 2.3452 20.7785 3.05739 20.7785 3.8C20.7781 4.15683 20.6371 4.50005 20.3843 4.75952C20.1316 5.01899 19.7861 5.17513 19.4185 5.19604C19.051 5.21695 18.689 5.10106 18.4067 4.87203C18.1243 4.643 17.9428 4.31813 17.8994 3.9638L17.8892 3.8H12.1108L12.1006 3.9638C12.0572 4.31813 11.8757 4.643 11.5933 4.87203C11.311 5.10106 10.949 5.21695 10.5815 5.19604C10.2139 5.17513 9.86844 5.01899 9.61567 4.75952C9.36291 4.50005 9.22192 4.15683 9.22151 3.8C9.22128 3.09359 9.49658 2.41321 9.99221 1.89523C10.4878 1.37726 11.1672 1.05998 11.8941 1.007L12.1108 1H17.8892Z"
                  fill="currentColor"
                />
              </svg>
            </button>
          </form>

        <% } %>

      </div>

      <!-- Попап редактирования поста (десктоп); на мобильном не открывается —
           кнопка-карандаш ведёт на отдельную страницу /post/:shortId/edit -->
      <% if (currentUser && post.author && (currentUser._id.toString() === post.author._id.toString() || currentUser.isAdmin)) { %>
        <div class="edit-post-modal-backdrop" id="edit-post-backdrop" hidden>
          <div class="edit-post-modal" id="edit-post-modal" role="dialog" aria-modal="true" aria-labelledby="edit-post-modal-heading">
            <h2 id="edit-post-modal-heading" class="edit-post-heading">Редактирование поста</h2>

            <form id="edit-post-form" action="/post/<%= post.shortId %>/edit" method="POST" class="edit-post-form">
              <label class="edit-post-field">
                <span class="edit-post-field-label">Заголовок поста</span>
                <input type="text" name="title" maxlength="200" value="<%= post.title %>" placeholder="Название поста">
              </label>

              <label class="edit-post-field edit-post-field-grow">
                <span class="edit-post-field-label">Описание</span>
                <textarea name="description" maxlength="2000" placeholder="Описание текст поста"><%= post.description %></textarea>
              </label>

              <div class="edit-post-actions">
                <button type="button" class="btn-edit-cancel" id="edit-post-cancel">Отмена</button>
                <button type="submit" class="btn-edit-save">Сохранить</button>
              </div>
            </form>
          </div>
        </div>
      <% } %>

      <div class="post-actions-right post-stats-new">

        <span class="post-stat-new">
          <svg width="19" height="19" viewBox="0 0 30 30" fill="none">
            <path
              d="M15 11C13.915 11 12.8745 11.4214 12.1073 12.1716C11.3401 12.9217 10.9091 13.9391 10.9091 15C10.9091 16.0609 11.3401 17.0783 12.1073 17.8284C12.8745 18.5786 13.915 19 15 19C16.085 19 17.1255 18.5786 17.8927 17.8284C18.6599 17.0783 19.0909 16.0609 19.0909 15C19.0909 13.9391 18.6599 12.9217 17.8927 12.1716C17.1255 11.4214 16.085 11 15 11ZM15 21.6667C13.1917 21.6667 11.4575 20.9643 10.1788 19.714C8.90016 18.4638 8.18182 16.7681 8.18182 15C8.18182 13.2319 8.90016 11.5362 10.1788 10.286C11.4575 9.03571 13.1917 8.33333 15 8.33333C16.8083 8.33333 18.5425 9.03571 19.8212 10.286C21.0998 11.5362 21.8182 13.2319 21.8182 15C21.8182 16.7681 21.0998 18.4638 19.8212 19.714C18.5425 20.9643 16.8083 21.6667 15 21.6667ZM15 5C8.18182 5 2.35909 9.14667 0 15C2.35909 20.8533 8.18182 25 15 25C21.8182 25 27.6409 20.8533 30 15C27.6409 9.14667 21.8182 5 15 5Z"
              fill="currentColor"
            />
          </svg>

          <span id="post-views-count"><%= post.views || 0 %></span>
        </span>

      </div>

    </div>

  </div>


  <!-- Комментарии -->
  <div class="comments comments-new">

    <h2>
      <span id="post-comments-count"><%= post.commentsCount || 0 %></span> комментар<%= (post.commentsCount || 0) === 1 ? 'ий' : 'иев' %>
    </h2>

    <div class="comments-list-new">

      <% if (!comments || comments.length === 0) { %>

        <div class="comments-empty-new">
          Пока нет комментариев. Будьте первым.
        </div>

      <% } else { %>

        <% comments.forEach(function(c) {
          const isCommentAuthor = currentUser && c.author && currentUser._id.toString() === c.author._id.toString();
          const canManageComment = currentUser && (isCommentAuthor || currentUser.isAdmin);
          const isPostAuthor = post.author && c.author && post.author._id.toString() === c.author._id.toString();
          const commentTime = c.createdAt
            ? new Date(c.createdAt).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' })
            : '';
        %>

          <article class="comment-new" data-comment-id="<%= c._id %>">

            <div class="comment-main-new">

              <div class="comment-avatar-new">
                <% if (c.author && c.author.avatarUrl) { %>
                  <img src="<%= c.author.avatarUrl %>" alt="<%= c.author.username %>">
                <% } else { %>
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="8" r="3.5" stroke="white" stroke-width="2"/>
                    <path d="M5 21c.5-4 2.8-6 7-6s6.5 2 7 6" stroke="white" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                <% } %>
              </div>

              <div class="comment-content-new">

                <div class="comment-head-new">
                  <span class="comment-author-new"><%= c.author.username %></span>

                  <% if (isPostAuthor) { %>
                    <span class="comment-badge-new">Автор</span>
                  <% } %>

                  <span class="comment-time-new"><%= commentTime %></span>
                </div>

                <p class="comment-text-new js-comment-text"><%= c.text %></p>

                <% if (canManageComment) { %>
                  <form
                    action="/comment/<%= c._id %>/edit"
                    method="POST"
                    class="comment-edit-form-new js-comment-form"
                    hidden
                  >
                    <textarea name="text" maxlength="1000" required><%= c.text %></textarea>
                    <div class="comment-edit-actions-new">
                      <button type="button" class="comment-edit-cancel-new js-cancel-comment-edit">Отмена</button>
                      <button type="submit">Сохранить</button>
                    </div>
                  </form>
                <% } %>

                <div class="comment-actions-new">

                  <button
                    type="button"
                    class="comment-like-btn-new <%= currentUser && c.likes && c.likes.some(function(id) { return id.toString() === currentUser._id.toString(); }) ? 'liked' : '' %>"
                    data-comment-id="<%= c._id %>"
                    aria-label="Поставить лайк"
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M20.8 8.8c0 5.4-8.8 10.2-8.8 10.2S3.2 14.2 3.2 8.8C3.2 6 5.2 4 7.7 4c1.6 0 3.2.8 4.3 2.1C13.1 4.8 14.7 4 16.3 4c2.5 0 4.5 2 4.5 4.8Z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                    </svg>
                    <span><%= c.likes ? c.likes.length : 0 %></span>
                  </button>

                  <% if (currentUser) { %>
                    <button
                      type="button"
                      class="comment-action-link-new js-reply-comment"
                      data-comment-id="<%= c._id %>"
                      data-username="<%= c.author.username %>"
                    >Ответить</button>
                  <% } %>

                  <% if (canManageComment) { %>
                    <button
                      type="button"
                      class="comment-action-link-new js-edit-comment"
                    >Редактировать</button>

                    <form
                      action="/comment/<%= c._id %>/delete"
                      method="POST"
                      class="comment-delete-form-new js-comment-form"
                    >
                      <button type="submit" class="comment-action-link-new comment-action-danger-new">Удалить</button>
                    </form>
                  <% } %>

                </div>

                <% if (currentUser) { %>
                  <form
                    action="/post/<%= post.shortId %>/comment"
                    method="POST"
                    class="comment-reply-form-new js-comment-form"
                    data-reply-to="<%= c._id %>"
                    hidden
                  >
                    <input type="hidden" name="parent" value="<%= c._id %>">
                    <textarea
                      name="text"
                      maxlength="1000"
                      placeholder="Ответить @<%= c.author.username %>..."
                      required
                    ></textarea>
                    <div class="comment-edit-actions-new">
                      <button type="button" class="comment-edit-cancel-new js-cancel-reply">Отмена</button>
                      <button type="submit">Ответить</button>
                    </div>
                  </form>
                <% } %>

              </div>
            </div>

            <% if (c.replies && c.replies.length) { %>
              <div class="comment-replies-new">
                <% c.replies.forEach(function(r) {
                  const isReplyAuthor = currentUser && r.author && currentUser._id.toString() === r.author._id.toString();
                  const canManageReply = currentUser && (isReplyAuthor || currentUser.isAdmin);
                  const replyTime = r.createdAt
                    ? new Date(r.createdAt).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' })
                    : '';
                %>

                  <article class="comment-reply-new" data-comment-id="<%= r._id %>">

                    <div class="comment-avatar-new comment-avatar-reply-new">
                      <% if (r.author && r.author.avatarUrl) { %>
                        <img src="<%= r.author.avatarUrl %>" alt="<%= r.author.username %>">
                      <% } else { %>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                          <circle cx="12" cy="8" r="3.5" stroke="white" stroke-width="2"/>
                          <path d="M5 21c.5-4 2.8-6 7-6s6.5 2 7 6" stroke="white" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                      <% } %>
                    </div>

                    <div class="comment-content-new">
                      <div class="comment-head-new">
                        <span class="comment-author-new"><%= r.author.username %></span>
                        <span class="comment-time-new"><%= replyTime %></span>
                      </div>

                      <p class="comment-text-new js-comment-text"><span class="comment-mention-new">@<%= c.author.username %></span> <%= r.text %></p>

                      <% if (canManageReply) { %>
                        <form
                          action="/comment/<%= r._id %>/edit"
                          method="POST"
                          class="comment-edit-form-new js-comment-form"
                          hidden
                        >
                          <textarea name="text" maxlength="1000" required><%= r.text %></textarea>
                          <div class="comment-edit-actions-new">
                            <button type="button" class="comment-edit-cancel-new js-cancel-comment-edit">Отмена</button>
                            <button type="submit">Сохранить</button>
                          </div>
                        </form>
                      <% } %>

                      <div class="comment-actions-new">
                        <button
                          type="button"
                          class="comment-like-btn-new <%= currentUser && r.likes && r.likes.some(function(id) { return id.toString() === currentUser._id.toString(); }) ? 'liked' : '' %>"
                          data-comment-id="<%= r._id %>"
                          aria-label="Поставить лайк"
                        >
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M20.8 8.8c0 5.4-8.8 10.2-8.8 10.2S3.2 14.2 3.2 8.8C3.2 6 5.2 4 7.7 4c1.6 0 3.2.8 4.3 2.1C13.1 4.8 14.7 4 16.3 4c2.5 0 4.5 2 4.5 4.8Z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                          </svg>
                          <span><%= r.likes ? r.likes.length : 0 %></span>
                        </button>

                        <% if (currentUser) { %>
                          <button
                            type="button"
                            class="comment-action-link-new js-reply-comment"
                            data-comment-id="<%= c._id %>"
                            data-username="<%= r.author.username %>"
                          >Ответить</button>
                        <% } %>

                        <% if (canManageReply) { %>
                          <button type="button" class="comment-action-link-new js-edit-comment">Редактировать</button>

                          <form
                            action="/comment/<%= r._id %>/delete"
                            method="POST"
                            class="comment-delete-form-new js-comment-form"
                          >
                            <button type="submit" class="comment-action-link-new comment-action-danger-new">Удалить</button>
                          </form>
                        <% } %>
                      </div>

                      <% if (currentUser) { %>
                        <form
                          action="/post/<%= post.shortId %>/comment"
                          method="POST"
                          class="comment-reply-form-new js-comment-form"
                          data-reply-to="<%= c._id %>"
                          hidden
                        >
                          <input type="hidden" name="parent" value="<%= c._id %>">
                          <textarea
                            name="text"
                            maxlength="1000"
                            placeholder="Ответить @<%= r.author.username %>..."
                            required
                          ></textarea>
                          <div class="comment-edit-actions-new">
                            <button type="button" class="comment-edit-cancel-new js-cancel-reply">Отмена</button>
                            <button type="submit">Ответить</button>
                          </div>
                        </form>
                      <% } %>
                    </div>
                  </article>

                <% }) %>
              </div>
            <% } %>

          </article>

        <% }) %>

      <% } %>

    </div>

    <% if (currentUser) { %>
      <form
        action="/post/<%= post.shortId %>/comment"
        method="POST"
        class="comment-form-new js-comment-form"
      >
        <textarea
          name="text"
          maxlength="1000"
          placeholder="Написать комментарий..."
          required
        ></textarea>
        <button type="submit">Отправить</button>
      </form>
    <% } else { %>
      <div class="comment-login-new">
        <a href="/login?next=/post/<%= post.shortId %>">Войдите</a>, чтобы оставить комментарий.
      </div>
    <% } %>

  </div>

</div>

</div> 


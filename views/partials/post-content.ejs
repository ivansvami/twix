<%

  const firstFile = post.files && post.files[0] ? post.files[0] : null;

  const firstUrl = firstFile ? firstFile.url : '';

  

  // Проверяем точное наличие ссылок на TikTok, Instagram Reels или YouTube Shorts

  const isTiktok = firstUrl && firstUrl.includes('tiktok.com');

  const isInsta = firstUrl && (firstUrl.includes('instagram.com/reel') || firstUrl.includes('/reels/'));

  const isYtShorts = firstUrl && firstUrl.includes('shorts/');



  const isVerticalVideo = isTiktok || isInsta || isYtShorts;

%>



<div class="post-modal-inner">

  <a href="/" class="post-close js-close-post" aria-label="Закрыть">✕</a>



<div class="post-media-area" style="position: relative; width: 100%; height: 100%; min-height: 500px; background: #000; overflow: hidden; display: block;">

    <% post.files.forEach(function(f) {

      const ytMatch = f.url && f.url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([\w-]{11})/);

      const tiktokMatch = f.url && f.url.match(/tiktok\.com\/.*\/video\/(\d+)/);

      const instaMatch = f.url && f.url.match(/instagram\.com\/(?:reel|reels)\/([\w-]+)/);



      const ytEmbedUrl = ytMatch ? 'https://www.youtube.com/embed/' + ytMatch[1] : null;

      const tiktokEmbedUrl = tiktokMatch ? 'https://www.tiktok.com/embed/v2/' + tiktokMatch[1] : null;

      const instaEmbedUrl = instaMatch ? 'https://www.instagram.com/reel/' + instaMatch[1] + '/embed/' : null;

    %>

      <% if (ytEmbedUrl) { %>

        <iframe src="<%= ytEmbedUrl %>" title="YouTube" loading="lazy" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position:absolute; top:0; left:0; width:100%; height:100%; border:0;"></iframe>

      <% } else if (tiktokEmbedUrl) { %>

        <!-- Абсолютное позиционирование растягивает iframe на весь блок -->

        <iframe src="<%= tiktokEmbedUrl %>" title="TikTok" loading="lazy" allow="autoplay; encrypted-media" allowfullscreen style="position:absolute; top:0; left:0; width:100%; height:100%; border:0;"></iframe>

      <% } else if (instaEmbedUrl) { %>

        <iframe src="<%= instaEmbedUrl %>" title="Instagram" loading="lazy" allow="autoplay; encrypted-media" allowfullscreen style="position:absolute; top:0; left:0; width:100%; height:100%; border:0;"></iframe>

<% } else if (f.resourceType === 'video') { %>

        <div class="custom-player" data-custom-player>
          <video src="<%= f.url %>" playsinline class="cp-video"></video>

          <button type="button" class="cp-bigplay" aria-label="Воспроизвести">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="#fff"><path d="M8 5v14l11-7z"/></svg>
          </button>

          <div class="cp-controls">
            <div class="cp-progress" role="slider" aria-label="Перемотка" tabindex="0">
              <div class="cp-progress-track"></div>
              <div class="cp-progress-buffered"></div>
              <div class="cp-progress-fill"></div>
              <div class="cp-progress-handle"></div>
            </div>

            <div class="cp-bar">
              <button type="button" class="cp-btn cp-play" aria-label="Пауза/Воспроизвести">
                <svg class="cp-icon-play" width="16" height="16" viewBox="0 0 24 24" fill="#fff"><path d="M8 5v14l11-7z"/></svg>
                <svg class="cp-icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="#fff" hidden><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
              </button>

              <span class="cp-time">0:00 / 0:00</span>

              <a href="<%= f.url %>" target="_blank" rel="noopener noreferrer" class="cp-btn cp-open" aria-label="Открыть файл в новой вкладке">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M14 3h7v7"/><path d="M10 14L21 3"/><path d="M21 14v5a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h5"/></svg>
              </a>

              <button type="button" class="cp-btn cp-fullscreen" aria-label="Полный экран">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"/></svg>
              </button>

              <div class="cp-speed-wrap">
                <button type="button" class="cp-btn cp-speed-toggle" aria-label="Настройки">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="#fff"><path d="M12 8a4 4 0 100 8 4 4 0 000-8zm8.94 2.5l-1.72-.29a7.03 7.03 0 00-.5-1.2l1.02-1.42a1 1 0 00-.1-1.28l-1.42-1.42a1 1 0 00-1.28-.1l-1.42 1.02a7.03 7.03 0 00-1.2-.5L14.03 3a1 1 0 00-1-.86h-2.06a1 1 0 00-1 .86l-.29 1.72a7.03 7.03 0 00-1.2.5L7.06 4.2a1 1 0 00-1.28.1L4.36 5.72a1 1 0 00-.1 1.28l1.02 1.42a7.03 7.03 0 00-.5 1.2l-1.72.3a1 1 0 00-.86 1v2.06a1 1 0 00.86 1l1.72.29c.13.42.3.82.5 1.2l-1.02 1.42a1 1 0 00.1 1.28l1.42 1.42a1 1 0 001.28.1l1.42-1.02c.38.2.78.37 1.2.5l.29 1.72a1 1 0 001 .86h2.06a1 1 0 001-.86l.29-1.72c.42-.13.82-.3 1.2-.5l1.42 1.02a1 1 0 001.28-.1l1.42-1.42a1 1 0 00.1-1.28l-1.02-1.42c.2-.38.37-.78.5-1.2l1.72-.29a1 1 0 00.86-1v-2.06a1 1 0 00-.86-1z"/></svg>
                </button>
                <div class="cp-speed-menu" hidden>
                  <p class="cp-speed-title">Скорость</p>
                  <button type="button" class="cp-speed-option" data-speed="0.25">0.25</button>
                  <button type="button" class="cp-speed-option" data-speed="0.5">0.5</button>
                  <button type="button" class="cp-speed-option" data-speed="0.75">0.75</button>
                  <button type="button" class="cp-speed-option is-active" data-speed="1">Обычная</button>
                  <button type="button" class="cp-speed-option" data-speed="1.25">1.25</button>
                  <button type="button" class="cp-speed-option" data-speed="1.5">1.5</button>
                  <button type="button" class="cp-speed-option" data-speed="2">2</button>
                </div>
              </div>

              <div class="cp-volume-wrap">
                <button type="button" class="cp-btn cp-mute" aria-label="Звук">
                  <svg class="cp-icon-vol-on" width="16" height="16" viewBox="0 0 24 24" fill="#fff"><path d="M3 10v4h4l5 5V5L7 10H3z"/><path d="M16.5 12a4.5 4.5 0 00-2.5-4.03v8.06A4.5 4.5 0 0016.5 12z"/></svg>
                  <svg class="cp-icon-vol-off" width="16" height="16" viewBox="0 0 24 24" fill="#fff" hidden><path d="M3 10v4h4l5 5V5L7 10H3z"/><path d="M19 8l-4 4m0-4l4 4" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
                <input type="range" class="cp-volume" min="0" max="1" step="0.01" value="0.2" aria-label="Громкость">
              </div>
            </div>
          </div>
        </div>

      <% } else if (f.resourceType === 'audio') { %>

        <div class="audio-wrap" style="display:flex; align-items:center; justify-content:center; height:100%;">

          <div class="audio-icon">🎵</div>

          <audio src="<%= f.url %>" controls></audio>

        </div>

      <% } else { %>

        <img src="<%= f.url %>" alt="" style="position:absolute; top:0; left:0; width:100%; height:100%; object-fit:contain;">

      <% } %>

    <% }) %>

  </div>



<div class="post-side post-side-new">

  <!-- Информация о посте -->
  <div class="post-info-new">

    <!-- Автор -->
    <div class="post-user-new">
      <div class="post-user-avatar-new">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="8" r="3.5" stroke="white" stroke-width="2"/>
          <path d="M5 21c.5-4 2.8-6 7-6s6.5 2 7 6"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"/>
        </svg>
      </div>

      <span>@<%= post.author.username %></span>
    </div>


    <!-- Заголовок -->
    <h1 class="post-title-new">
      <%= post.title || 'Без названия' %>
    </h1>


    <!-- Описание -->
    <% if (post.description) { %>
      <div class="post-description-new"><%= post.description %></div>
    <% } %>


    <!-- Статистика -->
    <div class="post-actions-new">

      <div class="post-stats-new">

        <span class="post-stat-new">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none">
            <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"
                  stroke="currentColor"
                  stroke-width="1.8"/>
            <circle cx="12" cy="12" r="2.5"
                    stroke="currentColor"
                    stroke-width="1.8"/>
          </svg>

          <span><%= post.views || 0 %></span>
        </span>


        <span class="post-stat-new">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none">
            <path d="M20 11.5a7 7 0 0 1-7 7H8l-4 3v-5.2a7 7 0 1 1 16-4.8Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linejoin="round"/>
          </svg>

          <span><%= post.commentsCount || 0 %></span>
        </span>

      </div>


      <!-- Лайк -->
      <button
        type="button"
        id="like-btn"
        data-shortid="<%= post.shortId %>"
        class="post-like-new <%= currentUser && post.likes.some(id => id.toString() === currentUser._id.toString()) ? 'liked' : '' %>"
        aria-label="Поставить лайк"
      >
        <svg
          class="post-like-icon"
          width="19"
          height="19"
          viewBox="0 0 24 24"
        >
          <path
            d="M20.8 8.8c0 5.4-8.8 10.2-8.8 10.2S3.2 14.2 3.2 8.8C3.2 6 5.2 4 7.7 4c1.6 0 3.2.8 4.3 2.1C13.1 4.8 14.7 4 16.3 4c2.5 0 4.5 2 4.5 4.8Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          />
        </svg>

        <span id="like-count"><%= post.likes.length %></span>
      </button>


      <!-- Копировать ссылку -->
      <button
        type="button"
        id="copy-post-link"
        class="post-copy-link-new"
        data-url="<%= '/post/' + post.shortId %>"
        aria-label="Скопировать ссылку"
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none">
          <path
            d="M10 13.5a4 4 0 0 0 5.7.1l2.2-2.2a4 4 0 0 0-5.7-5.7l-1.3 1.3"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
          <path
            d="M14 10.5a4 4 0 0 0-5.7-.1l-2.2 2.2a4 4 0 0 0 5.7 5.7l1.3-1.3"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>
      </button>

    </div>

  </div>


<!-- Комментарии -->
<div class="comments comments-new">

  <h2>
    <%= post.commentsCount || 0 %> комментарий<%= (post.commentsCount || 0) === 1 ? '' : 'ев' %>
  </h2>

  <!-- Список комментариев -->
  <div class="comments-list-new">

    <% if (!comments || comments.length === 0) { %>

      <div class="comments-empty-new">
        Пока нет комментариев. Будьте первым.
      </div>

    <% } else { %>

      <% comments.forEach(function(c) { 

        const isPostAuthor =
          post.author &&
          c.author &&
          post.author._id.toString() === c.author._id.toString();

        const isCurrentUser =
          currentUser &&
          c.author &&
          currentUser._id.toString() === c.author._id.toString();

        const commentDate = c.createdAt ? new Date(c.createdAt) : null;

        let commentTime = 'только что';

        if (commentDate) {
          const diff = Date.now() - commentDate.getTime();
          const minutes = Math.floor(diff / 60000);
          const hours = Math.floor(diff / 3600000);
          const days = Math.floor(diff / 86400000);

          if (minutes >= 1 && minutes < 60) {
            commentTime = minutes + ' мин. назад';
          } else if (hours >= 1 && hours < 24) {
            commentTime = hours + ' ч. назад';
          } else if (days >= 1) {
            commentTime = days + ' дн. назад';
          }
        }
      %>

        <!-- Основной комментарий -->
        <div class="comment-new">

          <div class="comment-main-new">

            <!-- Аватар -->
            <div class="comment-avatar-new">

              <% if (c.author && c.author.avatarUrl) { %>

                <img
                  src="<%= c.author.avatarUrl %>"
                  alt="<%= c.author.username %>"
                >

              <% } else { %>

                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                >
                  <circle
                    cx="12"
                    cy="8"
                    r="3.5"
                    stroke="white"
                    stroke-width="2"
                  />

                  <path
                    d="M5 21c.5-4 2.8-6 7-6s6.5 2 7 6"
                    stroke="white"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                </svg>

              <% } %>

            </div>


            <!-- Содержимое -->
            <div class="comment-content-new">

              <div class="comment-head-new">

                <span class="comment-author-new">
                  <%= c.author.username %>
                </span>

                <% if (isPostAuthor) { %>

                  <span class="comment-badge-new">
                    Автор
                  </span>

                <% } %>

                <span class="comment-time-new">
                  <%= commentTime %>
                </span>

              </div>


              <p class="comment-text-new">
                <%= c.text %>
              </p>


              <!-- Действия -->
              <div class="comment-actions-new">

                <button
                  type="button"
                  class="comment-like-btn-new <%= currentUser && c.likes && c.likes.some(id => id.toString() === currentUser._id.toString()) ? 'liked' : '' %>"
                  data-comment-id="<%= c._id %>"
                  aria-label="Нравится"
                >

                  <svg
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                  >
                    <path
                      d="M20.8 8.8c0 5.4-8.8 10.2-8.8 10.2S3.2 14.2 3.2 8.8C3.2 6 5.2 4 7.7 4c1.6 0 3.2.8 4.3 2.1C13.1 4.8 14.7 4 16.3 4c2.5 0 4.5 2 4.5 4.8Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                    />
                  </svg>

                  <span>
                    <%= c.likes ? c.likes.length : 0 %>
                  </span>

                </button>


                <% if (currentUser) { %>

                  <button
                    type="button"
                    class="comment-action-link-new js-reply-comment"
                    data-comment-id="<%= c._id %>"
                    data-username="<%= c.author.username %>"
                  >
                    Ответить
                  </button>

                <% } else { %>

                  <span class="comment-action-link-new">
                    Ответить
                  </span>

                <% } %>


                <% if (isCurrentUser) { %>

                  <button
                    type="button"
                    class="comment-action-link-new"
                  >
                    Редактировать
                  </button>

                  <button
                    type="button"
                    class="comment-action-link-new comment-action-danger-new"
                  >
                    Удалить
                  </button>

                <% } %>

              </div>

            </div>

          </div>


          <!-- Ответы -->
          <% if (c.replies && c.replies.length) { %>

            <% c.replies.forEach(function(r) {

              const isReplyCurrentUser =
                currentUser &&
                r.author &&
                currentUser._id.toString() === r.author._id.toString();

              const replyDate = r.createdAt ? new Date(r.createdAt) : null;

              let replyTime = 'только что';

              if (replyDate) {
                const diff = Date.now() - replyDate.getTime();
                const minutes = Math.floor(diff / 60000);
                const hours = Math.floor(diff / 3600000);
                const days = Math.floor(diff / 86400000);

                if (minutes >= 1 && minutes < 60) {
                  replyTime = minutes + ' мин. назад';
                } else if (hours >= 1 && hours < 24) {
                  replyTime = hours + ' ч. назад';
                } else if (days >= 1) {
                  replyTime = days + ' дн. назад';
                }
              }
            %>

              <div class="comment-reply-new">

                <!-- Аватар ответа -->
                <div class="comment-avatar-new comment-avatar-reply-new">

                  <% if (r.author && r.author.avatarUrl) { %>

                    <img
                      src="<%= r.author.avatarUrl %>"
                      alt="<%= r.author.username %>"
                    >

                  <% } else { %>

                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                    >
                      <circle
                        cx="12"
                        cy="8"
                        r="3.5"
                        stroke="white"
                        stroke-width="2"
                      />

                      <path
                        d="M5 21c.5-4 2.8-6 7-6s6.5 2 7 6"
                        stroke="white"
                        stroke-width="2"
                        stroke-linecap="round"
                      />
                    </svg>

                  <% } %>

                </div>


                <div class="comment-content-new">

                  <div class="comment-head-new">

                    <span class="comment-author-new">
                      <%= r.author.username %>
                    </span>

                    <span class="comment-time-new">
                      <%= replyTime %>
                    </span>

                  </div>


                  <p class="comment-text-new">

                    <span class="comment-mention-new">
                      @<%= c.author.username %>
                    </span>

                    <%= r.text %>

                  </p>


                  <div class="comment-actions-new">

                    <button
                      type="button"
                      class="comment-like-btn-new"
                      data-comment-id="<%= r._id %>"
                      aria-label="Нравится"
                    >

                      <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                      >
                        <path
                          d="M20.8 8.8c0 5.4-8.8 10.2-8.8 10.2S3.2 14.2 3.2 8.8C3.2 6 5.2 4 7.7 4c1.6 0 3.2.8 4.3 2.1C13.1 4.8 14.7 4 16.3 4c2.5 0 4.5 2 4.5 4.8Z"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                        />
                      </svg>

                      <span>
                        <%= r.likes ? r.likes.length : 0 %>
                      </span>

                    </button>


                    <% if (currentUser) { %>

                      <button
                        type="button"
                        class="comment-action-link-new js-reply-comment"
                        data-comment-id="<%= r._id %>"
                        data-username="<%= r.author.username %>"
                      >
                        Ответить
                      </button>

                    <% } %>


                    <% if (isReplyCurrentUser) { %>

                      <button
                        type="button"
                        class="comment-action-link-new"
                      >
                        Редактировать
                      </button>

                      <button
                        type="button"
                        class="comment-action-link-new comment-action-danger-new"
                      >
                        Удалить
                      </button>

                    <% } %>

                  </div>

                </div>

              </div>

            <% }) %>

          <% } %>

        </div>

      <% }) %>

    <% } %>

  </div>


  <!-- Форма нового комментария -->
  <% if (currentUser) { %>

    <form
      action="/post/<%= post.shortId %>/comment"
      method="POST"
      class="comment-form-new"
    >

      <textarea
        name="text"
        placeholder="Написать комментарий..."
        required
      ></textarea>

      <button type="submit">
        Отправить
      </button>

    </form>

  <% } else { %>

    <div class="comment-login-new">
      <a href="/login">Войдите</a>, чтобы оставить комментарий.
    </div>

  <% } %>

</div>


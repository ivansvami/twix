<%- include('partials/header', { pageTitle: 'Вход - MyFeed' }) %>

<div class="form-page narrow">
  <h1>Вход</h1>
  <% if (error) { %><p class="error"><%= error %></p><% } %>

  <a href="/login/twitch?next=<%= encodeURIComponent(next || '/') %>" class="btn-twitch">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M4 2 2 7v13h6v2h4l2-2h4l4-4V2H4zm18 13-3 3h-5l-2 2h-2v-2H6V4h16v11z"/><path d="M17 8h-2v5h2V8zm-5 0h-2v5h2V8z"/></svg>
    Войти через Twitch
  </a>

  <div class="divider"><span>или</span></div>

  <form action="/login" method="POST">
    <input type="hidden" name="next" value="<%= next %>">
    <label>
      Email или имя пользователя
      <input type="text" name="emailOrUsername" required>
    </label>
    <label>
      Пароль
      <input type="password" name="password" required>
    </label>
    <button type="submit" class="btn-primary">Войти</button>
  </form>
  <p>Нет аккаунта? <a href="/register">Зарегистрироваться</a></p>
</div>

<%- include('partials/footer') %>

<%- include('partials/header', { pageTitle: 'Лента - twix by salonamasle', activeNav }) %>
<!-- 1. Идет форма фильтров (теперь заканчивается здесь и внутри нет кнопки) -->
<form class="filters" method="GET" action="<%= activeNav === 'videos' ? '/videos' : '/' %>" style="display: flex; align-items: flex-end; gap: 20px;">
  <label>
    Категория
    <select name="category" onchange="this.form.submit()">
      <option value="all" <%= category === 'all' ? 'selected' : '' %>>Всё</option>
      <option value="image" <%= category === 'image' ? 'selected' : '' %>>Изображения</option>
      <option value="video" <%= category === 'video' ? 'selected' : '' %>>Видео</option>
      <option value="audio" <%= category === 'audio' ? 'selected' : '' %>>Аудио</option>
      <option value="album" <%= category === 'album' ? 'selected' : '' %>>Альбомы</option>
    </select>
  </label>
  <!-- (тут также ваши селекты сортировки и периода) -->
</form>

<!-- 2. Сетка с постами -->
<div class="grid" id="posts-grid">
  <% if (posts.length === 0) { %>
    <p class="empty" id="empty-feed">Нет файлов для отображения</p>
  <% } %>

  <% posts.forEach(function(post) { %>
    <!-- карточки постов -->
  <% }) %>
</div>

<!-- 3. ВСТАВЬТЕ ЭТОТ БОК С КНОПКОЙ СРАЗУ ПОСЛЕ СЕТКИ ПОСТОВ -->
<div class="mobile-suggest-container">
  <button type="button" id="open-suggest-video" class="btn-suggest-video">
    Предложить видео
  </button>
</div>



<div class="grid" id="posts-grid">

  <% if (posts.length === 0) { %>

    <p class="empty" id="empty-feed">Нет файлов для отображения</p>

  <% } %>



  <% posts.forEach(function(post) {

    const firstFile = post.files && post.files[0];

    const rawUrl = firstFile ? firstFile.url : '';



    const ytMatch =

      rawUrl &&

      rawUrl.match(

        /(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([\w-]{11})/

      );



    const youtubeId = ytMatch ? ytMatch[1] : null;



    const ytEmbedUrl = youtubeId

      ? 'https://www.youtube.com/embed/' + youtubeId

      : null;



    const ytWatchUrl = youtubeId

      ? 'https://www.youtube.com/watch?v=' + youtubeId

      : null;



    const isYoutube = Boolean(youtubeId);



    const mediaUrl = rawUrl || '';

  %>



    <article

      class="card <%= isYoutube ? 'card-youtube' : '' %>"

      data-shortid="<%= post.shortId %>"

    >



      <div class="card-media">



        <% if (isYoutube) { %>



          <div class="yt-preview-wrap">



            <iframe

              class="yt-preview-iframe"

              src="<%= ytEmbedUrl %>?enablejsapi=1&mute=1&controls=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0"

              title="<%= post.title || 'YouTube видео' %>"

              loading="lazy"

              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"

              allowfullscreen

              tabindex="-1"

            ></iframe>



            <!--

              Клик именно по превью открывает YouTube.

              target="_blank" = новая вкладка.

            -->

            <a

              href="<%= ytWatchUrl %>"

              target="_blank"

              rel="noopener noreferrer"

              class="yt-preview-link"

              aria-label="Открыть видео на YouTube"

            ></a>



            <span class="yt-card-open">

              Открыть на YouTube

            </span>



          </div>



<% } else if (firstFile) { %>



          <% if (firstFile.resourceType === 'video') { %>



            <video

              src="<%= mediaUrl %>"

              muted

              playsinline

              preload="metadata"

            ></video>



          <% } else if (firstFile.resourceType === 'audio') { %>



            <div

              class="audio-thumb"

              aria-label="Аудиофайл"

            >

              🎵

            </div>



          <% } else { %>



            <img

              src="<%= mediaUrl %>"

              alt="<%= post.title || 'Изображение' %>"

              loading="lazy"

            >



          <% } %>



        <% } %>



        <% if (post.isNsfw) { %>

          <span class="tag-nsfw">18+</span>

        <% } %>



      </div>



      <!--

        Всё, что находится здесь, открывает пост.

        Клик не переходит на отдельную страницу,

        а обрабатывается существующим JS-механизмом popup.

      -->

      <button

        type="button"

        class="post-card-open js-post-link"

        data-shortid="<%= post.shortId %>"

        aria-label="Открыть публикацию <%= post.title || 'Без названия' %>"

      >



        <div class="card-body">



          <h3 class="card-title">

            <%= post.title || 'Без названия' %>

          </h3>



          <p class="card-meta">

            <span>👁 <%= post.views || 0 %></span>

            <span>❤ <%= post.likesCount || 0 %></span>

            <span>💬 <%= post.commentsCount || 0 %></span>

          </p>



          <p class="card-author">

            @<%= post.author.username %>

          </p>



        </div>



      </button>



    </article>



  <% }) %>

</div>



<%- include('partials/footer') %> 


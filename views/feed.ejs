<%- include('partials/header', { pageTitle: 'Лента - twix by salonamasle', activeNav }) %>

<form
  class="filters"
  method="GET"
  action="<%= activeNav === 'videos' ? '/videos' : '/' %>"
>
  <!-- Категория -->
  <div class="filter-dropdown" data-filter="category">
    <button type="button" class="filter-dropdown-toggle">
      <span class="filter-dropdown-value">
        <%= category === 'image' ? 'Изображения' :
            category === 'video' ? 'Видео' :
            category === 'audio' ? 'Аудио' :
            category === 'album' ? 'Альбомы' :
            'Всё' %>
      </span>

      <span class="filter-dropdown-arrow"></span>
    </button>

    <div class="filter-dropdown-menu">
      <button
        type="button"
        class="filter-dropdown-option <%= category === 'all' ? 'selected' : '' %>"
        data-value="all"
      >
        Всё
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= category === 'image' ? 'selected' : '' %>"
        data-value="image"
      >
        Изображения
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= category === 'video' ? 'selected' : '' %>"
        data-value="video"
      >
        Видео
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= category === 'audio' ? 'selected' : '' %>"
        data-value="audio"
      >
        Аудио
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= category === 'album' ? 'selected' : '' %>"
        data-value="album"
      >
        Альбомы
      </button>
    </div>

    <input
      type="hidden"
      name="category"
      value="<%= category || 'all' %>"
    >
  </div>


  <!-- Сортировка -->
  <div class="filter-dropdown" data-filter="sort">
    <button type="button" class="filter-dropdown-toggle">
      <span class="filter-dropdown-value">
        <%= sort === 'views' ? 'По просмотрам' :
            sort === 'likes' ? 'По лайкам' :
            sort === 'comments' ? 'По комментариям' :
            'Новое' %>
      </span>

      <span class="filter-dropdown-arrow"></span>
    </button>

    <div class="filter-dropdown-menu">
      <button
        type="button"
        class="filter-dropdown-option <%= sort === 'new' ? 'selected' : '' %>"
        data-value="new"
      >
        Новое
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= sort === 'views' ? 'selected' : '' %>"
        data-value="views"
      >
        По просмотрам
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= sort === 'likes' ? 'selected' : '' %>"
        data-value="likes"
      >
        По лайкам
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= sort === 'comments' ? 'selected' : '' %>"
        data-value="comments"
      >
        По комментариям
      </button>
    </div>

    <input
      type="hidden"
      name="sort"
      value="<%= sort || 'new' %>"
    >
  </div>


  <!-- Период -->
  <div class="filter-dropdown" data-filter="period">
    <button type="button" class="filter-dropdown-toggle">
      <span class="filter-dropdown-value">
        <%= period === 'today' ? 'Сегодня' :
            period === 'week' ? 'Неделя' :
            period === 'month' ? 'Месяц' :
            period === 'year' ? 'Год' :
            'Всё время' %>
      </span>

      <span class="filter-dropdown-arrow"></span>
    </button>

    <div class="filter-dropdown-menu">
      <button
        type="button"
        class="filter-dropdown-option <%= period === 'today' ? 'selected' : '' %>"
        data-value="today"
      >
        Сегодня
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= period === 'week' ? 'selected' : '' %>"
        data-value="week"
      >
        Неделя
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= period === 'month' ? 'selected' : '' %>"
        data-value="month"
      >
        Месяц
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= period === 'year' ? 'selected' : '' %>"
        data-value="year"
      >
        Год
      </button>

      <button
        type="button"
        class="filter-dropdown-option <%= period === 'all' ? 'selected' : '' %>"
        data-value="all"
      >
        Всё время
      </button>
    </div>

    <input
      type="hidden"
      name="period"
      value="<%= period || 'all' %>"
    >
  </div>


  <!-- Кнопка предложения видео -->
  <button
    type="button"
    id="open-suggest-video"
    class="btn-suggest-video desktop-suggest-btn"
  >
    Предложить видео
  </button>
</form>

<div class="grid" id="posts-grid">
  <% if (posts.length === 0) { %>
    <p class="empty" id="empty-feed">Нет файлов для отображения</p>
  <% } %>

  <% posts.forEach(function(post) {
      const firstFile = post.files && post.files[0];
      const rawUrl = firstFile ? firstFile.url : '';
      
      const ytMatch = rawUrl && rawUrl.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([\w-]{11})/);
      const youtubeId = ytMatch ? ytMatch[1] : null;
      const ytEmbedUrl = youtubeId ? 'https://www.youtube.com/embed/' + youtubeId : null;
      const ytWatchUrl = youtubeId ? 'https://www.youtube.com/watch?v=' + youtubeId : null;
      
      const tiktokMatch = rawUrl && rawUrl.match(/tiktok\.com\/.*\/video\/(\d+)/);
      const instaMatch = rawUrl && rawUrl.match(/instagram\.com\/(?:reel|reels)\/([\w-]+)/);
      
      const isYoutube = Boolean(youtubeId);
      const isTiktok = Boolean(tiktokMatch);
      const isInsta = Boolean(instaMatch);
      const mediaUrl = rawUrl || '';
  %>
    <article class="card <%= isYoutube ? 'card-youtube' : '' %>" data-shortid="<%= post.shortId %>">
      <div class="card-media">
       <% if (isYoutube) { %>
          <% 
            const ytThumbUrl = 'https://img.youtube.com/vi/' + youtubeId + '/hqdefault.jpg';
            const ytWatchUrl = 'https://www.youtube.com/watch?v=' + youtubeId;
          %>
          
          <div class="yt-hover-card" data-ytid="<%= youtubeId %>" style="position: relative; width: 100%; padding-top: 56.25%; background: #000; overflow: hidden;">
            
            <!-- 1. Сам плеер (спрятан сзади, воспроизводится при наведении) -->
            <div class="yt-player-container" style="position: absolute; top: -10%; left: -10%; width: 120%; height: 120%; pointer-events: none;">
              <div class="yt-player-target"></div>
            </div>

            <!-- 2. Кликабельная обложка-заглушка, ведущая на YouTube в новой вкладке -->
            <a href="<%= ytWatchUrl %>" target="_blank" rel="noopener noreferrer" class="yt-cover-link" aria-label="Открыть видео на YouTube" style="position: absolute; inset: 0; z-index: 3; display: block;">
              <img class="yt-cover-img" src="<%= ytThumbUrl %>" alt="<%= post.title || 'YouTube видео' %>" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; transition: opacity 0.3s ease;">
              
              <!-- Небольшая иконка Play по центру для красоты -->
              <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="white" style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5)); opacity: 0.8;"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </a>

          </div>

        <% } else if (isTiktok) { %>
          <div class="external-video-wrap" style="position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #000; overflow: hidden;">
            <iframe src="https://www.tiktok.com/embed/v2/<%= tiktokMatch[1] %>" style="width: 100%; height: 100%; border: none; pointer-events: none;" allowfullscreen></iframe>
            <a href="/post/<%= post.shortId %>" class="post-card-open js-post-link" data-shortid="<%= post.shortId %>" style="position: absolute; inset: 0; z-index: 3;" aria-label="Открыть публикацию"></a>
          </div>
        <% } else if (isInsta) { %>
          <div class="external-video-wrap" style="position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #000; overflow: hidden;">
            <iframe src="https://www.instagram.com/reel/<%= instaMatch[1] %>/embed/" style="width: 100%; height: 100%; border: none; pointer-events: none;" allowfullscreen></iframe>
            <a href="/post/<%= post.shortId %>" class="post-card-open js-post-link" data-shortid="<%= post.shortId %>" style="position: absolute; inset: 0; z-index: 3;" aria-label="Открыть публикацию"></a>
          </div>
        <% } else if (firstFile) { %>
          <% if (firstFile.resourceType === 'video') { %>
            <video src="<%= mediaUrl %>" muted playsinline preload="metadata"></video>
          <% } else if (firstFile.resourceType === 'audio') { %>
            <div class="audio-thumb" aria-label="Аудиофайл">🎵</div>
          <% } else { %>
            <img src="<%= mediaUrl %>" alt="<%= post.title || 'Изображение' %>" loading="lazy">
          <% } %>
        <% } %>
        <% if (post.isNsfw) { %><span class="tag-nsfw">18+</span><% } %>
      </div>
      <button type="button" class="post-card-open js-post-link" data-shortid="<%= post.shortId %>" aria-label="Открыть публикацию <%= post.title || 'Без названия' %>">
        <div class="card-body">
          <h3 class="card-title"><%= post.title || 'Без названия' %></h3>
          <p class="card-meta">
            <span>👁 <%= post.views || 0 %></span>
            <span>❤ <%= post.likesCount || 0 %></span>
            <span>💬 <%= post.commentsCount || 0 %></span>
          </p>
          <p class="card-author">@<%= post.author.username %></p>
        </div>
      </button>
    </article>
  <% }) %>
</div>

<!-- Мобильная кнопка -->
<div class="mobile-suggest-container">
<button type="button" class="btn-suggest-video" onclick="document.getElementById('open-suggest-video').click()">
    Предложить видео
  </button>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const openBtn = document.getElementById('open-suggest-video');

    if (openBtn) {
      openBtn.addEventListener('click', () => {
        // Открываем popup, который подключается через footer.ejs
        const modal = document.getElementById('suggest-video-modal');

        if (modal) {
          modal.hidden = false;
          modal.style.display = 'flex';
        }
      });
    }
  });
</script>

<!-- Мобильная кнопка -->
<div class="mobile-suggest-container">
  <button type="button" class="btn-suggest-video" onclick="document.getElementById('open-suggest-video').click()">
    Предложить видео
  </button>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var dropdowns = document.querySelectorAll('.filter-dropdown');

    dropdowns.forEach(function (dropdown) {
      var toggle = dropdown.querySelector('.filter-dropdown-toggle');
      var options = dropdown.querySelectorAll('.filter-dropdown-option');
      var input = dropdown.querySelector('input[type="hidden"]');
      var valueEl = dropdown.querySelector('.filter-dropdown-value');

      toggle.addEventListener('click', function (e) {
        e.stopPropagation();

        dropdowns.forEach(function (other) {
          if (other !== dropdown) {
            other.classList.remove('open');
          }
        });

        dropdown.classList.toggle('open');
      });

      options.forEach(function (option) {
        option.addEventListener('click', function (e) {
          e.stopPropagation();

          var value = option.dataset.value;
          var text = option.textContent.trim();

          input.value = value;
          valueEl.textContent = text;

          options.forEach(function (item) {
            item.classList.remove('selected');
          });

          option.classList.add('selected');
          dropdown.classList.remove('open');

          dropdown.closest('form').submit();
        });
      });
    });

    document.addEventListener('click', function () {
      dropdowns.forEach(function (dropdown) {
        dropdown.classList.remove('open');
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        dropdowns.forEach(function (dropdown) {
          dropdown.classList.remove('open');
        });
      }
    });
  });
</script>

<%- include('partials/footer') %>

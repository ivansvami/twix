<%- include('partials/header', { pageTitle: 'Лента - twix by salonamasle', activeNav }) %>

<form class="filters" method="GET" action="<%= activeNav === 'videos' ? '/videos' : '/' %>">
  <label>
    Категория
    <select name="category" onchange="this.form.submit()">
      <option value="all" <%= category==='all'?'selected':'' %>>Всё</option>
      <option value="image" <%= category==='image'?'selected':'' %>>Изображения</option>
      <option value="video" <%= category==='video'?'selected':'' %>>Видео</option>
      <option value="audio" <%= category==='audio'?'selected':'' %>>Аудио</option>
      <option value="album" <%= category==='album'?'selected':'' %>>Альбомы</option>
    </select>
  </label>
  <label>
    Сортировка
    <select name="sort" onchange="this.form.submit()">
      <option value="new" <%= sort==='new'?'selected':'' %>>Новые</option>
      <option value="views" <%= sort==='views'?'selected':'' %>>По просмотрам</option>
      <option value="likes" <%= sort==='likes'?'selected':'' %>>По лайкам</option>
      <option value="comments" <%= sort==='comments'?'selected':'' %>>По комментариям</option>
    </select>
  </label>
  <label>
    Период
    <select name="period" onchange="this.form.submit()">
      <option value="today" <%= period==='today'?'selected':'' %>>Сегодня</option>
      <option value="week" <%= period==='week'?'selected':'' %>>Неделя</option>
      <option value="month" <%= period==='month'?'selected':'' %>>Месяц</option>
      <option value="year" <%= period==='year'?'selected':'' %>>Год</option>
      <option value="all" <%= period==='all'?'selected':'' %>>Всё время</option>
    </select>
  </label>
</form>

<div class="suggest-video-row">
  <button type="button" id="open-suggest-video" class="btn-suggest-video">Предложить видео</button>
</div>

<div class="grid">
  <% if (posts.length === 0) { %>
    <p class="empty">Нет файлов для отображения</p>
  <% } %>
  <% posts.forEach(function(post) { %>
    <a class="card js-post-link" href="/post/<%= post.shortId %>" data-shortid="<%= post.shortId %>">
      
      <div class="card-media">
        <% 
          // 1. Достаём ссылку откуда бы она ни пришла (files, imageUrl, videoUrl, url)
          const rawUrl = (post.files && post.files[0]) ? post.files[0].url : (post.imageUrl || post.videoUrl || post.url || '');

          // 2. Проверяем, ссылка ли это на YouTube
          function getYouTubeEmbed(url) {
            if (!url) return null;
            const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([\w-]{11})/);
            return match ? 'https://www.youtube.com/embed/' + match[1] : null;
          }

          const ytEmbedUrl = getYouTubeEmbed(rawUrl);
          const isDirectVideo = (post.files && post.files[0] && post.files[0].resourceType === 'video') || 
                                (rawUrl && rawUrl.match(/\.(mp4|webm|ogg|mov)(\?.*)?$/i));
          const isAudio = (post.files && post.files[0] && post.files[0].resourceType === 'audio') || 
                          (rawUrl && rawUrl.match(/\.(mp3|wav|ogg)(\?.*)?$/i));
        %>

        <% if (ytEmbedUrl) { %>
          <!-- Если YouTube — выводим встроенный плеер -->
          <iframe 
            src="<%= ytEmbedUrl %>" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
            style="width: 100%; height: 100%; aspect-ratio: 16/9; border: none; pointer-events: none;"
          ></iframe>
        <% } else if (isDirectVideo) { %>
          <!-- Если прямой видеофайл (.mp4) -->
          <video src="<%= rawUrl %>" muted preload="metadata"></video>
        <% } else if (isAudio) { %>
          <div class="audio-thumb">🎵</div>
        <% } else if (rawUrl) { %>
          <!-- Если картинка -->
          <img src="<%= rawUrl %>" alt="">
        <% } %>

        <% if (post.isNsfw) { %><span class="tag-nsfw">18+</span><% } %>
      </div>

      <div class="card-body">
        <p class="card-title"><%= post.title || 'Без названия' %></p>
        <p class="card-meta">
          <span>👁 <%= post.views %></span>
          <span>❤ <%= post.likesCount !== undefined ? post.likesCount : (post.likes ? post.likes.length : 0) %></span>
          <span>💬 <%= post.commentsCount %></span>
        </p>
        <p class="card-author">@<%= post.author ? post.author.username : 'аноним' %></p>
      </div>
    </a>
  <% }) %>
</div>

<% if (posts.length >= 24) { %>
  <div class="load-more">
    <a href="?category=<%= category %>&sort=<%= sort %>&period=<%= period %>&page=<%= page+1 %>" class="btn-outline">Загрузить ещё</a>
  </div>
<% } %>

<%- include('partials/footer') %>

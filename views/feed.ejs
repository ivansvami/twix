<!-- Разметка модального окна -->
<div id="postModal" class="post-modal-overlay" onclick="closePostModal(event)">
  <button class="post-modal-close" onclick="closePostModal(event, true)">&times;</button>
  <div class="post-modal-container" onclick="event.stopPropagation()">
    <div id="modalMedia" class="post-modal-media"></div>
    <div id="modalSidebar" class="post-modal-sidebar"></div>
  </div>
</div>

<script>
async function openPostModal(postId, shortId) {
  const targetId = shortId || postId;
  
  // Меняем URL в адресной строке без перезагрузки страницы
  history.pushState({ postId: targetId }, "", "/post/" + targetId);

  const response = await fetch("/post/" + targetId, {
    headers: { "Accept": "application/json" }
  });
  const data = await response.json();

  if (!data.post) return;

  // Отрисовка медиафайла
  const mediaContainer = document.getElementById("modalMedia");
  const file = data.post.files[0];
  if (file.resourceType === 'video') {
    mediaContainer.innerHTML = `<video src="${file.url}" controls autoplay loop></video>`;
  } else {
    mediaContainer.innerHTML = `<img src="${file.url}" alt="${data.post.title}">`;
  }

  // Отрисовка правого сайдбара
  const sidebar = document.getElementById("modalSidebar");
  sidebar.innerHTML = `
    <h3>${data.post.title || 'Без названия'}</h3>
    <p>Просмотров: ${data.post.views}</p>
    <hr>
    <div class="comments-section">
      <h4>Комментариев: ${data.comments.length}</h4>
      ${data.comments.map(c => `<div class="comment"><b>${c.author.username}:</b> ${c.text}</div>`).join('')}
    </div>
  `;

  document.getElementById("postModal").classList.add("active");
}

function closePostModal(event, force = false) {
  if (force || event.target.id === "postModal") {
    document.getElementById("postModal").classList.remove("active");
    // Возвращаем исходный URL ленты
    history.pushState(null, "", "/");
  }
}

// Перехват кнопки "Назад" в браузере
window.onpopstate = function() {
  document.getElementById("postModal").classList.remove("active");
};
</script>
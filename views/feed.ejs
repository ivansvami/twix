<%- include('partials/header', { pageTitle: 'Лента - twix by salonamasle', activeNav }) %>

<form class="filters" method="GET" action="<%= activeNav === 'videos' ? '/videos' : '/' %>" style="display: flex; align-items: flex-end; gap: 20px;">
  <label>
    Категория
    <select name="category" onchange="this.form.submit()">
      <option value="all" <%= category === 'all' ? 'selected' : '' %>>Всё</option>
      <option value="image" <%= category === 'image' ? 'selected' : '' %>>Изображения</option>
      <option value="video" <%= category === 'video' ? 'selected' : '' %>>Видео</option>
      <option value="audio" <%= category === 'audio' ? 'selected' : '' %>>Аудио</option>
      <option value="album" <%= category === 'album' ? 'selected' : '' %>>Альбомы</option>
    </select>
  </label>

  <label>
    Сортировка
    <select name="sort" onchange="this.form.submit()">
      <option value="new" <%= sort === 'new' ? 'selected' : '' %>>Новые</option>
      <option value="views" <%= sort === 'views' ? 'selected' : '' %>>По просмотрам</option>
      <option value="likes" <%= sort === 'likes' ? 'selected' : '' %>>По лайкам</option>
      <option value="comments" <%= sort === 'comments' ? 'selected' : '' %>>По комментариям</option>
    </select>
  </label>

  <label>
    Период
    <select name="period" onchange="this.form.submit()">
      <option value="today" <%= period === 'today' ? 'selected' : '' %>>Сегодня</option>
      <option value="week" <%= period === 'week' ? 'selected' : '' %>>Неделя</option>
      <option value="month" <%= period === 'month' ? 'selected' : '' %>>Месяц</option>
      <option value="year" <%= period === 'year' ? 'selected' : '' %>>Год</option>
      <option value="all" <%= period === 'all' ? 'selected' : '' %>>Всё время</option>
    </select>
  </label>

  <!-- Кнопка только для ПК -->
  <button type="button" id="open-suggest-video" class="btn-suggest-video desktop-suggest-btn" style="margin-left: auto;">
    Предложить видео
  </button>
</form>

<div class="grid" id="posts-grid">
  <% if (posts.length === 0) { %>
    <p class="empty" id="empty-feed">Нет файлов для отображения</p>
  <% } %>

  <% posts.forEach(function(post) {
      const firstFile = post.files && post.files[0];
      const rawUrl = firstFile ? firstFile.url : '';
      
      // Распознавание YouTube
      const ytMatch = rawUrl && rawUrl.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([\w-]{11})/);
      const youtubeId = ytMatch ? ytMatch[1] : null;
      const ytEmbedUrl = youtubeId ? 'https://www.youtube.com/embed/' + youtubeId : null;
      const ytWatchUrl = youtubeId ? 'https://www.youtube.com/watch?v=' + youtubeId : null;
      
      // Распознавание TikTok
      const tiktokMatch = rawUrl && rawUrl.match(/tiktok\.com\/.*\/video\/(\d+)/);
      
      // Распознавание Instagram Reels
      const instaMatch = rawUrl && rawUrl.match(/instagram\.com\/(?:reel|reels)\/([\w-]+)/);
      
      const isYoutube = Boolean(youtubeId);
      const isTiktok = Boolean(tiktokMatch);
      const isInsta = Boolean(instaMatch);
      const mediaUrl = rawUrl || '';
  %>
    <article class="card <%= isYoutube ? 'card-youtube' : '' %>" data-shortid="<%= post.shortId %>">
<div class="card-media">
        <% if (isYoutube) { %>
          <div class="yt-preview-wrap">
            <iframe class="yt-preview-iframe" src="<%= ytEmbedUrl %>?enablejsapi=1&mute=1&controls=0&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0" title="<%= post.title || 'YouTube видео' %>" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen tabindex="-1"></iframe>
            <a href="<%= ytWatchUrl %>" target="_blank" rel="noopener noreferrer" class="yt-preview-link" aria-label="Открыть видео на YouTube"></a>
            <span class="yt-card-open">Открыть на YouTube</span>
          </div>
        <% } else if (isTiktok) { %>
          <!-- Обертка для TikTok с защитным слоем, чтобы клик открывал модальное окно сайта -->
          <div class="external-video-wrap" style="position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #000; overflow: hidden;">
            <iframe src="https://www.tiktok.com/embed/v2/<%= tiktokMatch[1] %>" style="width: 100%; height: 100%; border: none; pointer-events: none;" allowfullscreen></iframe>
            <a href="/post/<%= post.shortId %>" class="post-card-open js-post-link" data-shortid="<%= post.shortId %>" style="position: absolute; inset: 0; z-index: 3;" aria-label="Открыть публикацию"></a>
          </div>
        <% } else if (isInsta) { %>
          <!-- Обертка для Instagram Reels с защитным слоем -->
          <div class="external-video-wrap" style="position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #000; overflow: hidden;">
            <iframe src="https://www.instagram.com/reel/<%= instaMatch[1] %>/embed/" style="width: 100%; height: 100%; border: none; pointer-events: none;" allowfullscreen></iframe>
            <a href="/post/<%= post.shortId %>" class="post-card-open js-post-link" data-shortid="<%= post.shortId %>" style="position: absolute; inset: 0; z-index: 3;" aria-label="Открыть публикацию"></a>
          </div>
        <% } else if (firstFile) { %>
          <% if (firstFile.resourceType === 'video') { %>
            <video src="<%= mediaUrl %>" muted playsinline preload="metadata"></video>
          <% } else if (firstFile.resourceType === 'audio') { %>
            <div class="audio-thumb" aria-label="Аудиофайл">🎵</div>
          <% } else { %>
            <img src="<%= mediaUrl %>" alt="<%= post.title || 'Изображение' %>" loading="lazy">
          <% } %>
        <% } %>
        <% if (post.isNsfw) { %><span class="tag-nsfw">18+</span><% } %>
      </div>
      <button type="button" class="post-card-open js-post-link" data-shortid="<%= post.shortId %>" aria-label="Открыть публикацию <%= post.title || 'Без названия' %>">
        <div class="card-body">
          <h3 class="card-title"><%= post.title || 'Без названия' %></h3>
          <p class="card-meta">
            <span>👁 <%= post.views || 0 %></span>
            <span>❤ <%= post.likesCount || 0 %></span>
            <span>💬 <%= post.commentsCount || 0 %></span>
          </p>
          <p class="card-author">@<%= post.author.username %></p>
        </div>
      </button>
    </article>
  <% }) %>
</div>

<!-- Мобильная кнопка -->
<div class="mobile-suggest-container">
  <button type="button" class="btn-suggest-video" onclick="document.getElementById('open-suggest-video').click()">
    Предложить видео
  </button>
</div>
<!-- Новый поп-ап для TikTok/Shorts/Reels -->
<div class="post-overlay" id="tiktok-modal" hidden>
  <div class="tiktok-popup-card">
    <button type="button" class="tiktok-close" id="close-tiktok-modal">&times;</button>
    <h2 class="tiktok-popup-title">Tiktok, shorts, reels</h2>
    <form action="/new" method="POST" class="tiktok-popup-body">
  <input type="hidden" name="category" value="video">
  <input type="hidden" name="uploadedFiles" id="tiktok-uploaded-files-json">

  <div class="tiktok-preview-box">
    <div class="tiktok-preview-placeholder"><span>▶</span><span>Превью видео</span></div>
  </div>
  <div class="tiktok-fields-box">
    <label class="tiktok-field-group">
      <span class="tiktok-label-text">Ссылка на: тикток, шортс, рилс</span>
      <!-- id меняем на tiktok-url-field, чтобы JS его нашел -->
      <input type="url" id="tiktok-url-field" class="tiktok-input" placeholder="https://..." required>
    </label>
    <div class="tiktok-field-group">
      <div class="tiktok-label-row">
        <span class="tiktok-label-text">Комментарий</span>
        <span class="tiktok-counter" id="tiktok-char-count">0/150</span>
      </div>
      <textarea name="title" maxlength="150" placeholder="Добавить комментарий" id="tiktok-comment-input" class="tiktok-textarea"></textarea>
    </div>
    <button type="submit" class="tiktok-submit-btn">Отправить</button>
  </div>
</form>
  </div>
</div>

<!-- Скрипт управления поп-апом -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const openBtn = document.getElementById('open-suggest-video'); // Исправлено на правильный ID
    const modal = document.getElementById('tiktok-modal');
    const closeBtn = document.getElementById('close-tiktok-modal');
    const commentInput = document.getElementById('tiktok-comment-input');
    const charCount = document.getElementById('tiktok-char-count');
    
    const form = modal.querySelector('form');
    const urlInput = document.getElementById('tiktok-url-field');
    const filesJsonInput = document.getElementById('tiktok-uploaded-files-json');

    // Логика открытия/закрытия
    if (openBtn && modal) {
      openBtn.addEventListener('click', (e) => {
        e.preventDefault();
        modal.hidden = false;
      });
    }

    if (closeBtn && modal) {
      closeBtn.addEventListener('click', () => {
        modal.hidden = true;
      });
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.hidden = true;
      });
    }

    // Счетчик символов
    if (commentInput && charCount) {
      commentInput.addEventListener('input', () => {
        charCount.textContent = commentInput.value.length + '/150';
      });
    }

    // Подготовка данных с ЗАПРЕТОМ YouTube
    if (form && urlInput && filesJsonInput) {
      form.addEventListener('submit', (e) => {
        const urlValue = urlInput.value.trim().toLowerCase();

        // Проверка: если ссылка содержит youtube или youtu.be, блокируем отправку
        if (urlValue.includes('youtube.com') || urlValue.includes('youtu.be')) {
          e.preventDefault();
          alert('Ссылки на YouTube в этом окне запрещены. Используйте только TikTok или Reels.');
          return false;
        }

        if (urlValue) {
          const fileData = [{
            url: urlInput.value.trim(),
            publicId: 'social_' + Date.now(),
            mimetype: 'video/mp4'
          }];
          filesJsonInput.value = JSON.stringify(fileData);
        }
      });
    }
  });
</script>
<%- include('partials/footer') %>

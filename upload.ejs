<%- include('partials/header', { pageTitle: 'Новый пост - twix by salonamasle' }) %>

<div class="upload-page">
  <h1>Новый пост</h1>
  <% if (typeof error !== 'undefined' && error) { %><p class="error"><%= error %></p><% } %>

  <form action="/new" method="POST" class="upload-form">
    <div class="upload-left">
      <div class="file-input-box" id="drop-zone">
        <input type="file" id="files-input" multiple hidden>

        <div id="drop-prompt" class="drop-prompt">
          <span class="drop-icon">☁️</span>
          <span class="drop-text">Перетащи файл сюда, вставь Ctrl + V</span>
          <span class="drop-or">или</span>
          <button type="button" id="choose-files-btn" class="btn-primary">Выберите файлы</button>
        </div>

        <div id="file-preview-container" class="file-preview-container" style="display: none;"></div>
      </div>

      <p class="uploaded-files-title">Загруженные файлы (<span id="files-count">0</span>/10)</p>
    </div>

    <div class="upload-right">
      <label>
        Название (не обязательно)
        <input type="text" name="title" maxlength="200" placeholder="Введите заголовок">
      </label>

      <label>
        Описание
        <textarea name="description" maxlength="2000" placeholder="Опционально"></textarea>
      </label>

      <div class="form-group">
        <span class="field-label">Тип доступа</span>
        <div class="access-row">
          <div class="visibility-toggle">
            <button type="button" class="visibility-btn is-active" data-visibility="public">👁 В ленту</button>
            <button type="button" class="visibility-btn" data-visibility="unlisted">🔒 Доступ по ссылке</button>
          </div>
          <input type="hidden" name="visibility" id="visibility-input" value="public">

          <label class="switch">
            <input type="checkbox" name="isNsfw" id="nsfw-switch">
            <span class="switch-track"></span>
            <span class="switch-label">Не для стрима</span>
          </label>
        </div>
        <p class="visibility-hint" id="visibility-hint">Пост появится в общей ленте у всех пользователей.</p>
      </div>

      <button type="submit" class="btn-primary btn-publish">Опубликовать</button>
    </div>
  </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const form = document.querySelector('form.upload-form');
  const fileInput = document.getElementById('files-input');
  const dropZone = document.getElementById('drop-zone');
  const dropPrompt = document.getElementById('drop-prompt');
  const previewContainer = document.getElementById('file-preview-container');
  const chooseBtn = document.getElementById('choose-files-btn');
  const filesCount = document.getElementById('files-count');
  const submitButton = form?.querySelector('button[type="submit"]');

  if (!form || !fileInput || !dropZone || !previewContainer) return;

  const visibilityButtons = document.querySelectorAll('.visibility-btn');
  const visibilityInput = document.getElementById('visibility-input');
  const visibilityHint = document.getElementById('visibility-hint');
  const visibilityHints = {
    public: 'Пост появится в общей ленте у всех пользователей.',
    unlisted: 'Пост не появится в ленте — открыть его можно только по прямой ссылке.'
  };

  visibilityButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      visibilityButtons.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      visibilityInput.value = btn.dataset.visibility;
      visibilityHint.textContent = visibilityHints[btn.dataset.visibility] || '';
    });
  });

  chooseBtn.addEventListener('click', () => fileInput.click());

  let selectedFiles = [];
  let uploadedFiles = [];
  let uploading = false;

  function formatBytes(bytes, decimals = 2) {
    if (!bytes) return '0 Bytes';
    const k = 1024;
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    return parseFloat((bytes / Math.pow(k, i)).toFixed(decimals)) + ' ' + sizes[i];
  }

  function syncInput() {
    const dt = new DataTransfer();
    selectedFiles.forEach(file => dt.items.add(file));
    fileInput.files = dt.files;
  }

  function renderFiles() {
    previewContainer.innerHTML = '';
    filesCount.textContent = selectedFiles.length;

    if (!selectedFiles.length) {
      dropPrompt.style.display = 'flex';
      previewContainer.style.display = 'none';
      return;
    }

    previewContainer.style.display = 'grid';

    selectedFiles.forEach((file, index) => {
      const card = document.createElement('div');
      card.className = 'file-preview-card';

      const left = document.createElement('div');
      left.className = 'file-info-left';

      const icon = document.createElement('div');
      icon.className = 'file-thumb-icon';
      icon.textContent = file.type.startsWith('video/') ? '🎬' :
                         file.type.startsWith('audio/') ? '🎵' : '🖼️';

      const details = document.createElement('div');
      details.className = 'file-details';

      const name = document.createElement('span');
      name.className = 'file-name';
      name.textContent = file.name;

      const size = document.createElement('span');
      size.className = 'file-size';
      size.textContent = formatBytes(file.size);

      details.append(name, size);
      left.append(icon, details);

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'file-remove-btn';
      remove.setAttribute('aria-label', 'Удалить файл');
      remove.textContent = '🗑️';
      remove.addEventListener('click', e => {
        e.preventDefault();
        e.stopPropagation();
        selectedFiles.splice(index, 1);
        uploadedFiles.splice(index, 1);
        syncInput();
        renderFiles();
      });

      card.append(left, remove);
      previewContainer.appendChild(card);
    });
  }

  function addFiles(files) {
    const incoming = Array.from(files || []);
    const combined = [...selectedFiles];

    for (const file of incoming) {
      if (!file.type.startsWith('image/') &&
          !file.type.startsWith('video/') &&
          !file.type.startsWith('audio/')) {
        alert(`Файл "${file.name}" имеет неподдерживаемый формат.`);
        continue;
      }

      if (combined.length >= 10) {
        alert('Можно загрузить максимум 10 файлов.');
        break;
      }

      combined.push(file);
    }

    selectedFiles = combined;
    uploadedFiles = [];
    syncInput();
    renderFiles();
  }

  fileInput.addEventListener('change', () => addFiles(fileInput.files));

  ['dragenter', 'dragover'].forEach(eventName => {
    dropZone.addEventListener(eventName, e => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.add('drag-over');
    });
  });

  ['dragleave', 'drop'].forEach(eventName => {
    dropZone.addEventListener(eventName, e => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.remove('drag-over');
    });
  });

  dropZone.addEventListener('drop', e => addFiles(e.dataTransfer.files));

  document.addEventListener('paste', e => {
    const files = [];
    for (const item of e.clipboardData?.items || []) {
      if (item.type.startsWith('image/')) {
        const file = item.getAsFile();
        if (file) files.push(file);
      }
    }
    if (files.length) addFiles(files);
  });

  async function getImageKitAuth() {
    const response = await fetch('/api/imagekit-auth', { credentials: 'same-origin' });
    const data = await response.json();
    if (!response.ok || !data.ok) {
      throw new Error(data.error || 'Не удалось получить данные загрузки');
    }
    return data;
  }

  async function uploadOne(file, auth) {
    const body = new FormData();
    body.append('file', file);
    body.append('fileName', file.name);
    body.append('publicKey', auth.publicKey);
    body.append('signature', auth.signature);
    body.append('expire', auth.expire);
    body.append('token', auth.token);
    body.append('folder', '/myfeed');
    body.append('useUniqueFileName', 'true');

    const response = await fetch('https://upload.imagekit.io/api/v1/files/upload', {
      method: 'POST',
      body
    });

    const data = await response.json();
    if (!response.ok) {
      throw new Error(data.message || data.help || `ImageKit: HTTP ${response.status}`);
    }

    return { url: data.url, publicId: data.fileId, mimetype: file.type, name: file.name };
  }

  form.addEventListener('submit', async e => {
    e.preventDefault();

    if (!selectedFiles.length) {
      alert('Выберите хотя бы один файл.');
      return;
    }

    if (uploading) return;
    uploading = true;
    submitButton.disabled = true;
    submitButton.textContent = 'Загрузка файлов…';

    try {
      const auth = await getImageKitAuth();
      uploadedFiles = [];

      for (let i = 0; i < selectedFiles.length; i++) {
        submitButton.textContent = `Загрузка ${i + 1} из ${selectedFiles.length}…`;
        uploadedFiles.push(await uploadOne(selectedFiles[i], auth));
      }

      let hidden = form.querySelector('input[name="uploadedFiles"]');
      if (!hidden) {
        hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'uploadedFiles';
        form.appendChild(hidden);
      }
      hidden.value = JSON.stringify(uploadedFiles);

      fileInput.disabled = true;
      form.submit();
    } catch (err) {
      console.error(err);
      alert('Не удалось загрузить файл: ' + err.message);
      uploading = false;
      submitButton.disabled = false;
      submitButton.textContent = 'Опубликовать';
    }
  });
});
</script>

<%- include('partials/footer') %>
